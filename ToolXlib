	t.BackgroundTransparency = 1
	t.Text = "Settings"
	t.TextColor3 = W.Theme.Text
	t.TextSize = 16
	setFont(t, FONTS.Title)
	t.TextXAlignment = Enum.TextXAlignment.Left
	local back = Instance.new("ImageButton", panel)
	back.Size = UDim2.new(0, 28, 0, 26)
	back.Position = UDim2.new(1, -32, 0, 2)
	back.BackgroundColor3 = Color3.fromRGB(60,15,15)
	back.BorderSizePixel = 0
	back.Image = ICONS.Back
	back.ImageColor3 = W.Config.Accent
	back.AutoButtonColor = false
	Instance.new("UICorner", back).CornerRadius = UDim.new(0, 4)
	local settingsOpen = false
	W.GearBtn.MouseButton1Click:Connect(function()
		if settingsOpen then return end
		W:PlayClick()
		local spin = TweenService:Create(W.GearBtn, E.QIO, {Rotation = 360})
		spin:Play()
		spin.Completed:Wait()
		W.GearBtn.Rotation = 0
		settingsOpen = true
		W.Main.Visible = false
		panel.Position = W.Main.Position
		panel.Visible = true
		W:FrameParticles(panel, "in", 45, 90)
		W:Shockwave(W.GearBtn, 30, W.Config.Accent, CU.darken(W.Config.Accent, 120), 0.7)
		W:ShakeFrame(panel, 5, 0.25)
	end)
	back.MouseButton1Click:Connect(function()
		if not settingsOpen then return end
		W:PlayClick()
		back.Rotation = 0
		TweenService:Create(back, E.QIO, {Rotation = -360}):Play()
		W:FrameParticles(panel, "out", 45, 90)
		W:ShakeFrame(panel, 6, 0.25)
		W:Shockwave(back, 25, W.Config.Accent, CU.darken(W.Config.Accent, 120), 0.65)
		task.wait(0.35)
		panel.Visible = false
		W.Main.Visible = true
		W.GearBtn.Rotation = 360
		TweenService:Create(W.GearBtn, E.QIO, {Rotation = 0}):Play()
		W:FrameParticles(W.Main, "in", 25, 60)
		settingsOpen = false
	end)
	local scroll = Instance.new("ScrollingFrame", panel)
	scroll.Size = UDim2.new(1, -12, 1, -40)
	scroll.Position = UDim2.new(0, 6, 0, 34)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 3
	scroll.ScrollBarImageColor3 = W.Config.Accent
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	local lay = Instance.new("UIListLayout", scroll)
	lay.Padding = UDim.new(0, 6)
	local keys = {"Sound", "Particles", "Shockwave", "Fire"}
	for _, k in ipairs(keys) do
		local b = Instance.new("TextButton", scroll)
		b.Size = UDim2.new(1, -6, 0, 28)
		b.BackgroundColor3 = W.Config.Effects[k] and W.Config.Accent or Color3.fromRGB(40,12,12)
		b.BorderSizePixel = 0
		b.Text = k..": "..(W.Config.Effects[k] and "ON" or "OFF")
		b.TextColor3 = Color3.new(1,1,1)
		b.TextSize = 12
		setFont(b, FONTS.Bold)
		b.AutoButtonColor = false
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
		b.MouseButton1Click:Connect(function()
			W:PlayClick()
			W.Config.Effects[k] = not W.Config.Effects[k]
			local on = W.Config.Effects[k]
			b.BackgroundColor3 = on and W.Config.Accent or Color3.fromRGB(40,12,12)
			b.Text = k..": "..(on and "ON" or "OFF")
		end)
	end
	local themeLbl = Instance.new("TextLabel", scroll)
	themeLbl.Size = UDim2.new(1, -6, 0, 20)
	themeLbl.BackgroundTransparency = 1
	themeLbl.Text = "THEMES"
	themeLbl.TextColor3 = W.Config.Accent
	themeLbl.TextSize = 12
	setFont(themeLbl, FONTS.Title)
	themeLbl.TextXAlignment = Enum.TextXAlignment.Left
	local themeHolder = Instance.new("Frame", scroll)
	themeHolder.Size = UDim2.new(1, -6, 0, 80)
	themeHolder.BackgroundTransparency = 1
	local rowLay = Instance.new("UIListLayout", themeHolder)
	rowLay.FillDirection = Enum.FillDirection.Horizontal
	rowLay.Padding = UDim.new(0, 3)
	rowLay.Wraps = true
	for name, data in pairs(THEMES) do
		local tb = Instance.new("TextButton", themeHolder)
		tb.Size = UDim2.new(0, 62, 0, 22)
		tb.BackgroundColor3 = data.Accent
		tb.BorderSizePixel = 0
		tb.Text = name
		tb.TextColor3 = Color3.new(1,1,1)
		tb.TextSize = 10
		setFont(tb, FONTS.Bold)
		tb.AutoButtonColor = false
		Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 4)
		tb.MouseButton1Click:Connect(function()
			W:PlayClick()
			W:SetTheme(name)
		end)
	end
	W.SettingsPanel = panel
end

