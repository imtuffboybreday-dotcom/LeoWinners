local MU = {}
function MU.clamp(v,a,b) return math.max(a, math.min(b, v)) end
function MU.round(n) return math.floor(n+0.5) end
function MU.roundTo(n,dp)
	local m = 10^dp
	return math.floor(n*m+0.5)/m
end
function MU.lerp(a,b,t) return a + (b-a)*t end
function MU.inverseLerp(a,b,v) if a==b then return 0 end; return (v-a)/(b-a) end
function MU.map(v,inMin,inMax,outMin,outMax) return outMin + (v-inMin)*(outMax-outMin)/(inMax-inMin) end
function MU.sign(n) return n > 0 and 1 or (n < 0 and -1 or 0) end
function MU.distance(a,b) return (a-b).Magnitude end
function MU.distance2D(a,b) return (Vector2.new(a.X,a.Z)-Vector2.new(b.X,b.Z)).Magnitude end
function MU.angleBetween(a,b) return math.acos(math.clamp(a.Unit:Dot(b.Unit),-1,1)) end
function MU.randomFloat(a,b) return a + math.random()*(b-a) end
function MU.randomInt(a,b) return math.random(a,b) end
function MU.randomVector(a,b)
	return Vector3.new(MU.randomFloat(a.X,b.X), MU.randomFloat(a.Y,b.Y), MU.randomFloat(a.Z,b.Z))
end
function MU.smooth(cur, tgt, speed, dt)
	return cur + (tgt-cur) * math.clamp(speed*dt*60, 0, 1)
end
function MU.moveTowards(a,b,maxDelta)
	local d = b - a
	if d.Magnitude <= maxDelta then return b end
	return a + d.Unit * maxDelta
end
function MU.wrap(n,min,max)
	local r = max - min
	return min + ((n - min) % r + r) % r
end
function MU.isPowerOfTwo(n) return n > 0 and (n & (n-1)) == 0 end
function MU.gcd(a,b) while b ~= 0 do a, b = b, a % b end; return a end
function MU.lcm(a,b) return a * b / MU.gcd(a,b) end
function MU.factorial(n) local r = 1; for i = 2, n do r = r * i end; return r end
function MU.fibonacci(n)
	if n < 2 then return n end
	local a, b = 0, 1
	for _ = 2, n do a, b = b, a + b end
	return b
end
function MU.isPrime(n)
	if n < 2 then return false end
	for i = 2, math.sqrt(n) do if n % i == 0 then return false end end
	return true
end
function MU.degrees(r) return math.deg(r) end
function MU.radians(d) return math.rad(d) end
function MU.sum(t)
	local s = 0
	for _,v in ipairs(t) do s = s + v end
	return s
end
function MU.avg(t) return MU.sum(t) / #t end
function MU.median(t)
	local c = {}
	for i,v in ipairs(t) do c[i] = v end
	table.sort(c)
	local n = #c
	if n % 2 == 0 then return (c[n/2]+c[n/2+1])/2 end
	return c[math.ceil(n/2)]
end
