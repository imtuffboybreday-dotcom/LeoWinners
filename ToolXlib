		scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
		scroll.Visible = false
		scroll.ZIndex = 6
		local lay = Instance.new("UIListLayout", scroll)
		lay.Padding = UDim.new(0, 6)
		lay.SortOrder = Enum.SortOrder.LayoutOrder
		local pad = Instance.new("UIPadding", scroll)
		pad.PaddingLeft = UDim.new(0, 4)
		pad.PaddingRight = UDim.new(0, 4)
		pad.PaddingTop = UDim.new(0, 4)
		pad.PaddingBottom = UDim.new(0, 4)
		scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		tb.Content = scroll
		tb.Layout = lay
		tb._order = 0
		tb._components = {}

		function tb:GetNextOrder() self._order = self._order + 1; return self._order end

		function tb:SetActive(v)
			scroll.Visible = v
			if v then btn.BackgroundColor3 = W.Config.Accent
			else btn.BackgroundColor3 = Color3.fromRGB(28,10,10) end
		end

		btn.MouseButton1Click:Connect(function()
			W:PlayClick()
			for _, t in ipairs(W.Tabs) do t:SetActive(false) end
			tb:SetActive(true)
		end)

		table.insert(W.Tabs, tb)
		if #W.Tabs == 1 then tb:SetActive(true) end
		return tb
	end

	return W
end

