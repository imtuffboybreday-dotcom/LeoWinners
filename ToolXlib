local RU = {}
function RU.cast(origin, dir, ignore)
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances = ignore or {lp.Character}
	return Workspace:Raycast(origin, dir, p)
end
function RU.castBetween(a, b, ignore)
	return RU.cast(a, b - a, ignore)
end
function RU.getPartInFront(maxDist, ignore)
	local cam = CAM.get()
	if not cam then return nil end
	local r = RU.cast(cam.CFrame.Position, cam.CFrame.LookVector * (maxDist or 500), ignore)
	return r and r.Instance, r and r.Position
end
function RU.isVisible(target, ignore)
	local cam = CAM.get()
	if not cam then return false end
	local p = RU.cast(cam.CFrame.Position, (target - cam.CFrame.Position), ignore)
	if not p then return true end
	return (p.Position - target).Magnitude < 1
end
