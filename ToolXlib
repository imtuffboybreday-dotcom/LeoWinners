local function safe(fn, ...)
	local ok, res = pcall(fn, ...)
	if not ok then warn("[ToolxUI]", res) end
	return ok, res
end
local function getParent()
	local h
	safe(function() h = gethui() end)
	return h or CoreGui
end
local function brighten(c, a) return Color3.fromRGB(math.min(c.R*255+a,255), math.min(c.G*255+a,255), math.min(c.B*255+a,255)) end
local function darken(c, s) return Color3.fromRGB(math.max(c.R*255-s,0), math.max(c.G*255-s,0), math.max(c.B*255-s,0)) end
local function clamp(v, a, b) return math.max(a, math.min(b, v)) end
local function round(n) return math.floor(n + 0.5) end

