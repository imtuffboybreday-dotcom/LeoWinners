-- ================== TOOLXUI CLASS ==================
function ToolxUI.new(opt)
	local self = setmetatable({}, ToolxUI)
	opt = opt or {}
	
	self.Config = {
		Title = opt.Title or "ToolxUI",
		Subtitle = opt.Subtitle or "",
		Width = opt.Width or 260,
		Height = opt.Height or 340,
		Accent = opt.Accent or Color3.fromRGB(220,20,20),
		Theme = opt.Theme or "Dark",
		Key = opt.Key,
		KeyHint = opt.KeyHint or "",
		Draggable = opt.Draggable ~= false,
		Resizable = opt.Resizable ~= false,
		MinWidth = 180, MaxWidth = 600,
		MinHeight = 160, MaxHeight = 700,
		Effects = {Sound = true, Particles = true, Shockwave = true, Fire = true, Shine = true, Spin = true},
		Language = opt.Language or "en",
		AutoSave = opt.AutoSave or false,
		ConfigFolder = opt.ConfigFolder or "ToolxUI_Configs",
		Debug = opt.Debug or false,
	}
	self.Theme = ToolxUI.Themes[self.Config.Theme] or ToolxUI.Themes.Dark
	self.Tabs = {}
	self.Elements = {}
	self.Connections = {}
	self.Notifications = {}
	self.Keybinds = {}
	self.Flags = {}
	self.FxGui = createFxGui()
	self.SoundBank = {}
	
	if opt.Parent then self.Parent = opt.Parent
	else self.Parent = (safe(function() return gethui() end) and gethui()) or CoreGui end
	
	if self.Config.Debug then print("[ToolxUI] Initialized:", self.Config.Title) end
	
	self:_buildSounds()
	self:_buildRoot()
	self:_buildNotifier()
	self:_buildTooltipLayer()
	if self.Config.Key then self:_buildKeySystem() end
	
	return self
end

