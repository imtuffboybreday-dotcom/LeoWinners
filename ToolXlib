-- ============= PLAYER UTILS =============
local PU = {}
function PU.all(excludeLocal)
	local o = {}
	for _,p in ipairs(Players:GetPlayers()) do
		if not excludeLocal or p ~= lp then table.insert(o,p) end
	end
	return o
end
function PU.byName(n)
	for _,p in ipairs(Players:GetPlayers()) do if p.Name:lower() == n:lower() then return p end end
end
function PU.byDisplayName(n)
	for _,p in ipairs(Players:GetPlayers()) do if p.DisplayName:lower() == n:lower() then return p end end
end
function PU.byId(id)
	for _,p in ipairs(Players:GetPlayers()) do if p.UserId == id then return p end end
end
function PU.byCharacter(char)
	for _,p in ipairs(Players:GetPlayers()) do if p.Character == char then return p end end
end
function PU.byPart(part)
	if not part then return nil end
	local char = part:FindFirstAncestorOfClass("Model")
	return char and PU.byCharacter(char)
end
function PU.alive(excludeLocal)
	local o = {}
	for _,p in ipairs(Players:GetPlayers()) do
		if (not excludeLocal or p ~= lp) and isAlive(p) then table.insert(o,p) end
	end
	return o
end
function PU.dead(excludeLocal)
	local o = {}
	for _,p in ipairs(Players:GetPlayers()) do
		if (not excludeLocal or p ~= lp) and not isAlive(p) then table.insert(o,p) end
	end
	return o
end
function PU.count() return #Players:GetPlayers() end
function PU.countAlive() return #PU.alive() end
function PU.countDead() return #PU.dead() end
function PU.closest(origin, excludeLocal)
	origin = origin or CHU.getPosition(lp)
	if not origin then return nil, math.huge end
	local near, minD = nil, math.huge
	for _,p in ipairs(Players:GetPlayers()) do
		if not excludeLocal or p ~= lp then
			local pp = CHU.getPosition(p)
			if pp then
				local d = (pp-origin).Magnitude
				if d < minD then minD = d; near = p end
			end
		end
	end
	return near, minD
end
function PU.farthest(origin)
	origin = origin or CHU.getPosition(lp)
	if not origin then return nil, 0 end
	local far, maxD = nil, 0
	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local pp = CHU.getPosition(p)
			if pp then
				local d = (pp-origin).Magnitude
				if d > maxD then maxD = d; far = p end
			end
		end
	end
	return far, maxD
end
function PU.distance(a,b)
	local pa, pb = CHU.getPosition(a), CHU.getPosition(b)
	if pa and pb then return (pa-pb).Magnitude end
	return math.huge
end
function PU.sorted(origin, excludeLocal)
	origin = origin or CHU.getPosition(lp)
	local o = {}
	for _,p in ipairs(Players:GetPlayers()) do
		if not excludeLocal or p ~= lp then
			local pp = CHU.getPosition(p)
			local d = (pp and origin) and (pp-origin).Magnitude or math.huge
			table.insert(o, {player = p, dist = d})
		end
	end
	table.sort(o, function(a,b) return a.dist < b.dist end)
	return o
end
function PU.inRadius(origin, radius)
	local o = {}
	if not origin then return o end
	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local pp = CHU.getPosition(p)
			if pp and (pp-origin).Magnitude <= radius then table.insert(o,p) end
		end
	end
	return o
end
function PU.randomPlayer(excludeLocal)
	local l = PU.all(excludeLocal)
	if #l == 0 then return nil end
	return l[math.random(1,#l)]
end
function PU.hasTool(p, name)
	local c = p and p.Character
	if not c then return false end
	for _,t in ipairs(c:GetChildren()) do
		if t:IsA("Tool") and (not name or t.Name == name) then return true end
	end
