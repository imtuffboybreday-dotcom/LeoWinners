-- ================== TOGGLE ==================
function ToolxUI:_wireToggle()
	local open = false
	local cd = false
	self.ToggleBtn.MouseButton1Click:Connect(function()
		if cd then return end
		self:PlayClick()
		cd = true
		open = not open
		if open then
			self.Main.Visible = true
			self:Shockwave(self.ToggleBtn, 40, self.Config.Accent, Color3.fromRGB(255,220,0), 0.85)
			task.wait(0.08)
			self:Shockwave(self.ToggleBtn, 30, Color3.fromRGB(0,220,255), Color3.fromRGB(255,0,200), 0.75)
			task.wait(0.06)
			self:Shockwave(self.ToggleBtn, 55, Color3.fromRGB(255,255,255), self.Config.Accent, 1)
			self:BurstAt(self.ToggleBtn.AbsolutePosition.X + self.ToggleBtn.AbsoluteSize.X/2 - self.FxGui.AbsolutePosition.X,
				self.ToggleBtn.AbsolutePosition.Y + self.ToggleBtn.AbsoluteSize.Y/2 - self.FxGui.AbsolutePosition.Y,
				self.Config.Accent, Color3.fromRGB(255,220,0), 12, 35)
			self:ShakeFrame(self.ToggleBtn, 5, 0.2)
			TweenService:Create(self.ToggleBtn, Ease.BackOut, {Size = UDim2.new(0,50,0,50)}):Play()
			task.delay(0.15, function()
				TweenService:Create(self.ToggleBtn, Ease.QuintOut, {Size = UDim2.new(0,42,0,42)}):Play()
			end)
			TweenService:Create(self.Main, Ease.QuintOut, {
				Position = UDim2.new(0.5, -self.Config.Width/2, 0.5, -self.Config.Height/2)
			}):Play()
		else
			TweenService:Create(self.Main, Ease.QuintOut, {
				Position = UDim2.new(0.5, -self.Config.Width/2, 1.5, 0)
			}):Play()
			task.wait(0.35)
			self.Main.Visible = false
		end
		task.wait(0.4)
		cd = false
	end)
	self.IsOpen = function() return open end
end

-- ================== MINIMIZE ==================
function ToolxUI:_wireMinimize()
	local minimized = false
	self.MinBtn.MouseButton1Click:Connect(function()
		self:PlayClick()
		minimized = not minimized
		self.MinBtn.Image = minimized and ICONS.Max or ICONS.Min
		self:BurstAt(self.MinBtn.AbsolutePosition.X + self.MinBtn.AbsoluteSize.X/2 - self.FxGui.AbsolutePosition.X,
			self.MinBtn.AbsolutePosition.Y + self.MinBtn.AbsoluteSize.Y/2 - self.FxGui.AbsolutePosition.Y,
			Color3.fromRGB(255,100,100), Color3.fromRGB(150,0,0), 8, 25)
		self:ShakeFrame(self.Main, 4, 0.2)
		self:Shockwave(self.MinBtn, 20, self.Config.Accent, darken(self.Config.Accent, 100), 0.55)
		TweenService:Create(self.Main, Ease.QuintOut, {
			Size = minimized and UDim2.new(0, self.Config.Width, 0, 34)
				or UDim2.new(0, self.Config.Width, 0, self.Config.Height)
		}):Play()
		if self.Body then
			self.Body.Visible = not minimized
		end
	end)
end

-- ================== DRAG ==================
function ToolxUI:_wireDrag()
	if not self.Config.Draggable then return end
	local dragging, dragStart, startPos = false, nil, nil
	self.Main.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, i.Position, self.Main.Position
		end
	end)
	self.Main.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			self.Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
end

-- ================== RESIZE ==================
function ToolxUI:_wireResize()
	if not self.Config.Resizable then return end
	local handle = Instance.new("TextButton", self.Main)
	handle.Size = UDim2.new(0, 16, 0, 16)
	handle.Position = UDim2.new(1, -18, 1, -18)
	handle.BackgroundTransparency = 1
	handle.Text = ""
	handle.ZIndex = 10
	local dragging, dragStart, startSize = false, nil, nil
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startSize = true, i.Position, self.Main.AbsoluteSize
		end
	end)
	handle.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			local w = math.clamp(startSize.X + d.X, self.Config.MinWidth, self.Config.MaxWidth)
			local h = math.clamp(startSize.Y + d.Y, self.Config.MinHeight, self.Config.MaxHeight)
			self.Main.Size = UDim2.new(0, w, 0, h)
			self.Config.Width = w
			self.Config.Height = h
		end
	end)
end

