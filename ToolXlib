local PU = {}

function PU.GetPlayers(excludeLocal)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if not excludeLocal or p ~= lp then table.insert(list, p) end
	end
	return list
end
function PU.GetPlayerByName(name)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower() == name:lower() then return p end
	end
end
function PU.GetPlayerByDisplayName(name)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.DisplayName:lower() == name:lower() then return p end
	end
end
function PU.GetPlayerById(id)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.UserId == id then return p end
	end
end
function PU.GetPlayerCharacter(p) return p and p.Character end
function PU.GetPlayerHumanoid(p) local c = p and p.Character; return c and c:FindFirstChildOfClass("Humanoid") end
function PU.GetPlayerRoot(p) local c = p and p.Character; return c and c:FindFirstChild("HumanoidRootPart") end
function PU.IsPlayerAlive(p)
	local h = PU.GetPlayerHumanoid(p)
	return h and h.Health > 0
end
function PU.GetPlayerHealth(p)
	local h = PU.GetPlayerHumanoid(p)
	return h and h.Health or 0
end
function PU.GetPlayerMaxHealth(p)
	local h = PU.GetPlayerHumanoid(p)
	return h and h.MaxHealth or 0
end
function PU.GetPlayerTeam(p) return p and p.Team end
function PU.GetPlayerTeamColor(p) return p and p.TeamColor end
function PU.GetPlayerPosition(p)
	local r = PU.GetPlayerRoot(p)
	return r and r.Position or nil
end
function PU.GetPlayerDistance(p)
	local r1 = PU.GetPlayerRoot(lp)
	local r2 = PU.GetPlayerRoot(p)
	if r1 and r2 then return (r1.Position - r2.Position).Magnitude end
	return math.huge
end
function PU.GetClosestPlayer(excludeLocal)
	local closest, minD = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local d = PU.GetPlayerDistance(p)
			if d < minD then minD = d; closest = p end
		end
	end
	return closest, minD
end
function PU.GetFarthestPlayer()
	local far, maxD = nil, 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local d = PU.GetPlayerDistance(p)
			if d > maxD then maxD = d; far = p end
		end
	end
	return far, maxD
end
function PU.GetSortedByDistance()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then table.insert(list, {player = p, dist = PU.GetPlayerDistance(p)}) end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	return list
end
function PU.GetAllAlive()
	local t = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and PU.IsPlayerAlive(p) then table.insert(t, p) end
	end
	return t
end
function PU.GetAllDead()
	local t = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and not PU.IsPlayerAlive(p) then table.insert(t, p) end
	end
	return t
end
function PU.GetRandomPlayer()
	local list = PU.GetPlayers(true)
	return list[math.random(1, #list)]
end
function PU.GetPlayerFromCharacter(char)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character == char then return p end
	end
end
function PU.GetPlayerByPart(part)
	local char = part and part:FindFirstAncestorOfClass("Model")
	if char then return PU.GetPlayerFromCharacter(char) end
end
function PU.GetPlayersInRadius(origin, radius)
	local t = {}
	if not origin then return t end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local pos = PU.GetPlayerPosition(p)
			if pos and (pos - origin).Magnitude <= radius then table.insert(t, p) end
		end
	end
	return t
end
function PU.GetNearestTo(pos)
	local near, minD = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local pp = PU.GetPlayerPosition(p)
			if pp then
				local d = (pp - pos).Magnitude
				if d < minD then minD = d; near = p end
			end
		end
	end
	return near, minD
end
function PU.GetHealthPercent(p)
	local h = PU.GetPlayerHumanoid(p)
	if h then return h.Health / h.MaxHealth end
	return 0
end
function PU.HasTool(p, name)
	local c = p and p.Character
	if not c then return false end
	for _, t in ipairs(c:GetChildren()) do
		if t:IsA("Tool") and (not name or t.Name == name) then return true end
	end
	return false
end
function PU.GetTools(p)
	local t = {}
	local c = p and p.Character
	if c then
		for _, o in ipairs(c:GetChildren()) do
			if o:IsA("Tool") then table.insert(t, o) end
		end
	end
	return t
end
function PU.GetBackpackTools(p)
	local t = {}
	local b = p and p.Backpack
	if b then
		for _, o in ipairs(b:GetChildren()) do
			if o:IsA("Tool") then table.insert(t, o) end
		end
	end
	return t
end
function PU.GetAllTools(p)
	local t = {}
	for _, o in ipairs(PU.GetTools(p)) do table.insert(t, o) end
	for _, o in ipairs(PU.GetBackpackTools(p)) do table.insert(t, o) end
	return t
end
function PU.HasBackpack(p) return p and p.Backpack end
function PU.GetCharacterParts(p)
	local c = p and p.Character
	local t = {}
	if c then
		for _, o in ipairs(c:GetChildren()) do
			if o:IsA("BasePart") then table.insert(t, o) end
		end
	end
	return t
end
function PU.IsPlayerTyping(p)
	if p == lp and UIS:GetFocusedTextBox() then return true end
	return false
end
function PU.GetPlayerAccountAge(p) return p and p.AccountAge or 0 end
function PU.GetPlayerMembership(p)
	if p.MembershipType == Enum.MembershipType.Premium then return "Premium" end
	return "None"
end
function PU.IsFriend(p) return p and p:IsFriendsWith(lp.UserId) end
function PU.GetPlayerTeam_ById(id)
	for _, p in ipairs(Players:GetPlayers()) do if p.UserId == id then return p.Team end end
end
function PU.GetRoleInGroup(p, groupId)
	return p and p:GetRoleInGroup(groupId)
end
function PU.GetRankInGroup(p, groupId)
	return p and p:GetRankInGroup(groupId)
end
function PU.GetPlayersByTeam(team)
	local t = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Team == team then table.insert(t, p) end
	end
	return t
end

