-- ================== SHINE SYSTEM ==================
local shineList = {}
local function addShine(g, spd)
	if not g then return end
	table.insert(shineList, {grad = g, speed = spd or 0.015, dir = 1})
	safe(function() g.Offset = Vector2.new(-1, 0) end)
end
RunService.RenderStepped:Connect(function(dt)
	local step = dt * 60
	for _, s in ipairs(shineList) do
		if s.grad and s.grad.Parent then
			local nx = s.grad.Offset.X + s.speed * step * s.dir
			if nx > 1 then s.dir = -1; nx = 1
			elseif nx < -1 then s.dir = 1; nx = -1 end
			s.grad.Offset = Vector2.new(nx, 0)
		end
	end
end)

-- ================== SPIN SYSTEM ==================
local spinList = {}
local function addSpin(obj, speed, axis)
	axis = axis or "Z"
	table.insert(spinList, {obj = obj, speed = speed or 1, axis = axis})
end
RunService.RenderStepped:Connect(function(dt)
	for _, s in ipairs(spinList) do
		if s.obj and s.obj.Parent then
			if s.axis == "Z" then
				s.obj.Rotation = (s.obj.Rotation + s.speed * dt * 60) % 360
			elseif s.axis == "Grad" then
				s.obj.Rotation = (s.obj.Rotation + s.speed * dt * 60) % 360
			end
		end
	end
end)

