-- ============= COLOR UTILS =============
local CU = {}
function CU.brighten(c,a) return Color3.fromRGB(math.min(c.R*255+a,255),math.min(c.G*255+a,255),math.min(c.B*255+a,255)) end
function CU.darken(c,s) return Color3.fromRGB(math.max(c.R*255-s,0),math.max(c.G*255-s,0),math.max(c.B*255-s,0)) end
function CU.lerp(a,b,t) return Color3.new(a.R+(b.R-a.R)*t,a.G+(b.G-a.G)*t,a.B+(b.B-a.B)*t) end
function CU.fromHex(h)
	h = h:gsub("#","")
	return Color3.fromRGB(tonumber(h:sub(1,2),16) or 0, tonumber(h:sub(3,4),16) or 0, tonumber(h:sub(5,6),16) or 0)
end
function CU.toHex(c) return string.format("#%02X%02X%02X", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255)) end
function CU.fromHSV(h,s,v) return Color3.fromHSV(h,s,v) end
function CU.toHSV(c) return c:ToHSV() end
function CU.random() return Color3.fromRGB(math.random(0,255),math.random(0,255),math.random(0,255)) end
function CU.gradient(c1,c2,steps)
	local t = {}
	for i = 1, steps do t[i] = CU.lerp(c1,c2,(i-1)/(steps-1)) end
	return t
end
function CU.complementary(c)
	local h,s,v = c:ToHSV()
	return Color3.fromHSV((h+0.5)%1, s, v)
end
function CU.invert(c) return Color3.new(1-c.R,1-c.G,1-c.B) end
function CU.grayscale(c)
	local a = (c.R+c.G+c.B)/3
	return Color3.new(a,a,a)
end
function CU.isDark(c) return (c.R*0.299+c.G*0.587+c.B*0.114) < 0.5 end
function CU.isLight(c) return not CU.isDark(c) end
function CU.contrastText(bg) return CU.isDark(bg) and Color3.new(1,1,1) or Color3.new(0,0,0) end
function CU.saturate(c,a)
	local h,s,v = c:ToHSV()
	return Color3.fromHSV(h, math.clamp(s+a,0,1), v)
end
function CU.desaturate(c,a) return CU.saturate(c,-a) end
function CU.blend(a,b,alpha) return CU.lerp(a,b,alpha) end
function CU.shift(c) return Color3.new(c.B,c.R,c.G) end
function CU.equals(a,b,tol)
	tol = tol or 0.01
	return math.abs(a.R-b.R)<tol and math.abs(a.G-b.G)<tol and math.abs(a.B-b.B)<tol
end
ToolxUI.ColorUtils = CU

