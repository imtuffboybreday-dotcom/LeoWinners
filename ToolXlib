-- ============= TABLE UTILS =============
local TU = {}
function TU.copy(t)
	local n = {}
	for k,v in pairs(t) do n[k] = v end
	return n
end
function TU.deepCopy(t)
	local n = {}
	for k,v in pairs(t) do
		if type(v) == "table" then n[k] = TU.deepCopy(v) else n[k] = v end
	end
	return n
end
function TU.merge(a,b)
	local n = TU.copy(a)
	for k,v in pairs(b) do n[k] = v end
	return n
end
function TU.keys(t)
	local o = {}
	for k in pairs(t) do table.insert(o,k) end
	return o
end
function TU.values(t)
	local o = {}
	for _,v in pairs(t) do table.insert(o,v) end
	return o
end
function TU.size(t)
	local n = 0
	for _ in pairs(t) do n = n + 1 end
	return n
end
function TU.contains(t,v)
	for _,x in ipairs(t) do if x == v then return true end end
	return false
end
function TU.containsKey(t,k) return t[k] ~= nil end
function TU.find(t,fn)
	for i,v in ipairs(t) do if fn(v,i) then return i,v end end
end
function TU.filter(t,fn)
	local o = {}
	for i,v in ipairs(t) do if fn(v,i) then table.insert(o,v) end end
	return o
end
function TU.map(t,fn)
	local o = {}
	for i,v in ipairs(t) do o[i] = fn(v,i) end
	return o
end
function TU.reduce(t,fn,init)
	local acc = init
	for i,v in ipairs(t) do acc = fn(acc,v,i) end
	return acc
end
function TU.reverse(t)
	local o = {}
	for i = #t, 1, -1 do table.insert(o,t[i]) end
	return o
end
function TU.shuffle(t)
	local o = TU.copy(t)
	for i = #o, 2, -1 do
		local j = math.random(i)
		o[i], o[j] = o[j], o[i]
	end
	return o
end
function TU.unique(t)
	local seen, o = {}, {}
	for _,v in ipairs(t) do
		if not seen[v] then seen[v] = true; table.insert(o,v) end
	end
	return o
end
function TU.flatten(t)
	local o = {}
	for _,v in ipairs(t) do
		if type(v) == "table" then
			for _,s in ipairs(TU.flatten(v)) do table.insert(o,s) end
		else table.insert(o,v) end
	end
	return o
end
function TU.first(t) return t[1] end
function TU.last(t) return t[#t] end
function TU.sort(t,fn) local o = TU.copy(t); table.sort(o,fn); return o end
function TU.count(t,fn)
	local n = 0
	for i,v in ipairs(t) do if fn(v,i) then n = n + 1 end end
	return n
end
function TU.zip(a,b)
	local o = {}
	for i = 1, math.min(#a,#b) do o[i] = {a[i], b[i]} end
	return o
end
ToolxUI.TableUtils = TU

-- ============= STRING UTILS =============
local SU = {}
function SU.split(s,sep)
	local o = {}
	for p in string.gmatch(s, "([^"..sep.."]+)") do table.insert(o,p) end
	return o
end
function SU.trim(s) return s:match("^%s*(.-)%s*$") end
function SU.startsWith(s,p) return s:sub(1,#p) == p end
function SU.endsWith(s,p) return s:sub(-#p) == p end
function SU.contains(s,p) return s:find(p,1,true) ~= nil end
function SU.replace(s,a,b) return s:gsub(a,b) end
function SU.upper(s) return s:upper() end
function SU.lower(s) return s:lower() end
function SU.capitalize(s) return s:sub(1,1):upper()..s:sub(2):lower() end
function SU.reverse(s) return s:reverse() end
function SU.repeatStr(s,n) return string.rep(s,n) end
function SU.padLeft(s,n,c) c = c or " "; while #s < n do s = c..s end; return s end
function SU.padRight(s,n,c) c = c or " "; while #s < n do s = s..c end; return s end
function SU.format(fmt, ...) return string.format(fmt, ...) end
function SU.len(s) return #s end
function SU.toNumber(s) return tonumber(s) end
function SU.join(t,sep) return table.concat(t, sep or ", ") end
function SU.count(s,sub)
	local n, i = 0, 1
	while true do
		local j = s:find(sub,i,true)
		if not j then break end
		n = n + 1
		i = j + #sub
	end
	return n
end
function SU.mask(s,ch) ch = ch or "*"; return string.rep(ch,#s) end
function SU.randomStr(n)
	local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	local o = {}
	for _ = 1, n do
		local i = math.random(1,#chars)
		table.insert(o, chars:sub(i,i))
	end
	return table.concat(o)
end
ToolxUI.StringUtils = SU

