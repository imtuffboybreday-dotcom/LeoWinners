function Tab:CreatePlayerList(cfg)
	cfg = cfg or {}
	local W = self.Window
	local scrolling = Instance.new("ScrollingFrame")
	scrolling.Size = UDim2.new(1, 0, 0, cfg.Height or 120)
	scrolling.BackgroundColor3 = Color3.fromRGB(18,8,8)
	scrolling.BorderSizePixel = 0
	scrolling.ScrollBarThickness = 3
	scrolling.ScrollBarImageColor3 = W.Config.Accent
	scrolling.CanvasSize = UDim2.new(0,0,0,0)
	scrolling.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scrolling.ZIndex = 6
	scrolling.LayoutOrder = self:GetNextOrder()
	scrolling.Parent = self.Content
	Instance.new("UICorner", scrolling).CornerRadius = UDim.new(0, 4)
	local l = Instance.new("UIListLayout", scrolling)
	l.Padding = UDim.new(0, 3)
	local p = Instance.new("UIPadding", scrolling)
	p.PaddingLeft = UDim.new(0, 3)
	p.PaddingRight = UDim.new(0, 3)
	p.PaddingTop = UDim.new(0, 3)
	local selected = nil
	local function update()
		for _, c in ipairs(scrolling:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= lp then
				local b = Instance.new("TextButton", scrolling)
				b.Size = UDim2.new(1, -6, 0, 26)
				b.BackgroundColor3 = Color3.fromRGB(28,10,10)
				b.BorderSizePixel = 0
				b.Text = pl.DisplayName
				b.TextColor3 = W.Theme.Text
				b.TextSize = 12
				setFont(b, FONTS.Body)
				b.AutoButtonColor = false
				b.TextXAlignment = Enum.TextXAlignment.Left
				b.ZIndex = 6
				Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
				b.MouseButton1Click:Connect(function()
					W:PlayClick()
					selected = pl
					for _, x in ipairs(scrolling:GetChildren()) do
						if x:IsA("TextButton") then x.BackgroundColor3 = Color3.fromRGB(28,10,10) end
					end
					b.BackgroundColor3 = W.Config.Accent
					if cfg.Callback then safe(cfg.Callback, pl) end
				end)
			end
		end
	end
	Players.PlayerAdded:Connect(update)
	Players.PlayerRemoving:Connect(update)
	update()
	return scrolling, function() return selected end, update
end

