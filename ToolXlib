						if x:IsA("TextButton") then x.BackgroundColor3 = Color3.fromRGB(28,10,10) end
					end
					b.BackgroundColor3 = self.Config.Accent
					if cfg.Callback then safe(cfg.Callback, p) end
				end)
				y += 29
			end
		end
		scrolling.CanvasSize = UDim2.new(0,0,0,y)
	end
	Players.PlayerAdded:Connect(update)
	Players.PlayerRemoving:Connect(update)
	update()
	self.Elements[#self.Elements+1] = scrolling
	return scrolling, function() return selected end
end

-- Config system (save/load)
function ToolxUI:SaveConfig(name)
	if not name or name == "" then return false end
	local folder = self.Config.ConfigFolder
	safe(function() if not isfolder(folder) then makefolder(folder) end end)
	local data = {
		width = self.Config.Width,
		height = self.Config.Height,
		accent = {self.Config.Accent.R, self.Config.Accent.G, self.Config.Accent.B},
		theme = self.Config.Theme,
		language = self.Config.Language,
		effects = self.Config.Effects,
		title = self.Config.Title,
		flags = self.Flags,
	}
	local ok = safe(function()
		writefile(folder.."/"..name..".json", HttpService:JSONEncode(data))
	end)
	if ok then self:Notify("✓ Config saved: "..name, self.Theme.Good) end
	return ok
end

function ToolxUI:LoadConfig(name)
	local folder = self.Config.ConfigFolder
	local path = folder.."/"..name..".json"
	if not isfile(path) then
		self:Notify("✗ Config not found: "..name, self.Theme.Danger)
		return false
	end
	local ok, data = safe(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or not data then return false end
	self.Config.Width = data.width or self.Config.Width
	self.Config.Height = data.height or self.Config.Height
	if data.accent then
		self:SetAccent(Color3.fromRGB(data.accent[1]*255, data.accent[2]*255, data.accent[3]*255))
	end
	if data.theme then self:SetTheme(data.theme) end
	if data.language then self.Config.Language = data.language end
	if data.effects then self.Config.Effects = data.effects end
	if data.flags then self.Flags = data.flags end
	self:SetSize(self.Config.Width, self.Config.Height)
	if data.title then self:SetTitle(data.title) end
	self:Notify("✓ Config loaded: "..name, self.Theme.Good)
	return true
end

function ToolxUI:DeleteConfig(name)
	local folder = self.Config.ConfigFolder
	local path = folder.."/"..name..".json"
	if isfile(path) then
		safe(function() delfile(path) end)
		self:Notify("✓ Config deleted: "..name, self.Theme.Warn)
		return true
	end
	return false
end

function ToolxUI:ListConfigs()
	local folder = self.Config.ConfigFolder
	local out = {}
	safe(function()
		if isfolder(folder) then
			for _, f in ipairs(listfiles(folder)) do
				local name = f:match("([^/\\]+)%.json$")
				if name then table.insert(out, name) end
			end
		end
	end)
	return out
end

