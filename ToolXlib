	-- WINDOW METHODS
	function W:SetAccent(color)
		self.Config.Accent = color
		self.Theme.Accent = color
		self.StrokeGrad.Color = ColorSequence.new(color, brighten(color, 70), color)
		self.BgGrad.Color = ColorSequence.new(darken(color, 200), Color3.fromRGB(8,8,8), darken(color, 200))
		self.TitleLbl.TextColor3 = color
		self.ToggleBtn.TextColor3 = color
		self.GearBtn.ImageColor3 = color
		self.MinBtn.ImageColor3 = color
	end

	function W:SetSize(w, h)
		w = clamp(w, self.Config.MinWidth, self.Config.MaxWidth)
		h = clamp(h, self.Config.MinHeight, self.Config.MaxHeight)
		self.Config.Width = w; self.Config.Height = h
		self.Main.Size = UDim2.new(0, w, 0, h)
		self.Main.Position = UDim2.new(0.5, -w/2, 0.5, -h/2)
	end
	function W:SetTitle(text)
		self.Config.Title = text
		self.TitleLbl.Text = text
	end
	function W:SetTheme(name)
		local t = THEMES[name]
		if not t then return end
		self.Theme = t
		self.Config.Theme = name
		self:SetAccent(t.Accent)
	end
	function W:ToggleEffect(key, val)
		if self.Config.Effects[key] ~= nil then self.Config.Effects[key] = val end
	end
	function W:SetFlag(k, v) self.Flags[k] = v end
	function W:GetFlag(k) return self.Flags[k] end
	function W:BindKey(keyCode, callback)
		local c = UIS.InputBegan:Connect(function(i, gp)
			if gp then return end
			if i.KeyCode == keyCode then safe(callback) end
		end)
		table.insert(self.Keybinds, c)
		return c
	end
	function W:SaveConfig(name)
		if not name or name == "" then return false end
		local f = self.Config.ConfigFolder
		safe(function() if not isfolder(f) then makefolder(f) end end)
		local data = {
			width = self.Config.Width, height = self.Config.Height,
			accent = {self.Config.Accent.R, self.Config.Accent.G, self.Config.Accent.B},
			theme = self.Config.Theme, effects = self.Config.Effects,
			title = self.Config.Title, flags = self.Flags,
		}
		local ok = safe(function() writefile(f.."/"..name..".json", HttpService:JSONEncode(data)) end)
		if ok then self:Notify("✓ Saved: "..name, self.Theme.Good) end
		return ok
	end
	function W:LoadConfig(name)
		local f = self.Config.ConfigFolder
		local path = f.."/"..name..".json"
		if not isfile(path) then self:Notify("✗ Not found: "..name, self.Theme.Danger) return false end
		local ok, data = safe(function() return HttpService:JSONDecode(readfile(path)) end)
		if not ok or not data then return false end
		self.Config.Width = data.width or self.Config.Width
		self.Config.Height = data.height or self.Config.Height
		if data.accent then self:SetAccent(Color3.fromRGB(data.accent[1]*255, data.accent[2]*255, data.accent[3]*255)) end
		if data.theme then self:SetTheme(data.theme) end
		if data.effects then self.Config.Effects = data.effects end
		if data.flags then self.Flags = data.flags end
		if data.title then self:SetTitle(data.title) end
		self:SetSize(self.Config.Width, self.Config.Height)
		self:Notify("✓ Loaded: "..name, self.Theme.Good)
		return true
	end
	function W:DeleteConfig(name)
		local f = self.Config.ConfigFolder
		local path = f.."/"..name..".json"
		if isfile(path) then safe(function() delfile(path) end); self:Notify("✓ Deleted: "..name, self.Theme.Warn); return true end
		return false
	end
	function W:ListConfigs()
		local f = self.Config.ConfigFolder
		local o = {}
		safe(function()
			if isfolder(f) then
				for _, file in ipairs(listfiles(f)) do
					local n = file:match("([^/\\]+)%.json$")
					if n then table.insert(o, n) end
				end
			end
		end)
		return o
	end
	function W:Destroy()
		safe(function() self.Gui:Destroy() end)
		if self.TooltipGui then safe(function() self.TooltipGui:Destroy() end) end
	end

