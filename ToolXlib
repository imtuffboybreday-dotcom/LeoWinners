function Tab:CreateSlider(cfg)
	cfg = cfg or {}
	local W = self.Window
	local min, max = cfg.Min or 0, cfg.Max or 100
	local val = MU.clamp(cfg.Default or min, min, max)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 38)
	holder.BackgroundTransparency = 1
	holder.LayoutOrder = self:GetNextOrder()
	holder.Parent = self.Content
	holder.ZIndex = 6
	local lbl = Instance.new("TextLabel", holder)
	lbl.Size = UDim2.new(1, 0, 0, 16)
	lbl.BackgroundTransparency = 1
	lbl.Text = (cfg.Text or "Slider")..": "..tostring(val)
	lbl.TextColor3 = W.Theme.Text
	lbl.TextSize = 12
	setFont(lbl, FONTS.Bold)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 6
	local track = Instance.new("TextButton", holder)
	track.Size = UDim2.new(1, 0, 0, 12)
	track.Position = UDim2.new(0, 0, 0, 20)
	track.BackgroundColor3 = Color3.fromRGB(30,10,10)
	track.BorderSizePixel = 0
	track.Text = ""
	track.AutoButtonColor = false
	track.ZIndex = 6
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
	local fill = Instance.new("Frame", track)
	fill.Size = UDim2.new((val-min)/(max-min), 0, 1, 0)
	fill.BackgroundColor3 = W.Config.Accent
	fill.BorderSizePixel = 0
	fill.ZIndex = 7
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
	local dragging = false
	local function upd(x)
		local pos = MU.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		val = MU.round(min + (max-min) * pos)
		fill.Size = UDim2.new(pos, 0, 1, 0)
		lbl.Text = (cfg.Text or "Slider")..": "..tostring(val)
		if cfg.Callback then safe(cfg.Callback, val) end
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; upd(i.Position.X) end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	return holder, function() return val end
end

