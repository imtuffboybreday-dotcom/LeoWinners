-- Attach to created tabs
local function attachTab(t)
	for k, v in pairs(Tab) do t[k] = v end
	return t
end

local _origCreateWindow = ToolxUI.CreateWindow
function ToolxUI:CreateWindow(opt)
	local W = _origCreateWindow(self, opt)
	local _origCT = W.CreateTab
	W.CreateTab = function(w, name)
		local tab = _origCT(w, name)
		attachTab(tab)
		return tab
	end
	return W
end

