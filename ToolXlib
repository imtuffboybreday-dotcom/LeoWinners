function ToolxUI:PlayClick(pitch)
	if not self.Config.Effects.Sound then return end
	local s = self.SoundBank.Click:Clone()
	s.Pitch = pitch or 1
	s.Parent = SoundService
	s:Play()
	task.delay(1, function() s:Destroy() end)
end
function ToolxUI:PlayHover()
