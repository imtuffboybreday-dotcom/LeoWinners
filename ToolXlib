-- ================== WINDOW METHODS ==================
function ToolxUI:SetAccent(color)
	self.Config.Accent = color
	self.Theme.Accent = color
	safe(function()
		self.StrokeGrad.Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0, color),
			ColorSequenceKeypoint.new(0.5, brighten(color, 70)),
			ColorSequenceKeypoint.new(1, color)
		}
		self.BgGrad.Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0, darken(color, 200)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8,8,8)),
			ColorSequenceKeypoint.new(1, darken(color, 200))
		}
		self.Title.TextColor3 = color
		self.ToggleBtn.TextColor3 = color
		self.ToggleStroke.Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0, color),
			ColorSequenceKeypoint.new(0.5, darken(color, 100)),
			ColorSequenceKeypoint.new(1, color)
		}
		self.GearBtn.ImageColor3 = color
		self.MinBtn.ImageColor3 = color
	end)
end

function ToolxUI:SetSize(w, h)
	w = math.clamp(w, self.Config.MinWidth, self.Config.MaxWidth)
	h = math.clamp(h, self.Config.MinHeight, self.Config.MaxHeight)
	self.Config.Width, self.Config.Height = w, h
	self.Main.Size = UDim2.new(0, w, 0, h)
	if self.IsOpen and self.IsOpen() then
		self.Main.Position = UDim2.new(0.5, -w/2, 0.5, -h/2)
	end
end

function ToolxUI:SetTitle(text)
	self.Config.Title = text
	self.Title.Text = text
end

function ToolxUI:SetTheme(themeName)
	local t = ToolxUI.Themes[themeName]
	if not t then return end
	self.Theme = t
	self.Config.Theme = themeName
	self:SetAccent(t.Accent)
end

function ToolxUI:ToggleEffects(key, value)
	if self.Config.Effects[key] ~= nil then
		self.Config.Effects[key] = value
	end
end

function ToolxUI:Destroy()
	safe(function() self.Gui:Destroy() end)
	safe(function() self.NotifGui:Destroy() end)
	safe(function() self.FxGui:Destroy() end)
	safe(function() if self.TooltipGui then self.TooltipGui:Destroy() end end)
	safe(function() if self.KeyGui then self.KeyGui:Destroy() end end)
end

