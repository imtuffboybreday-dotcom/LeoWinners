-- ================== UTIL ==================
local function brighten(c, add)
	return Color3.fromRGB(
		math.min(c.R*255+add, 255),
		math.min(c.G*255+add, 255),
		math.min(c.B*255+add, 255)
	)
end
local function darken(c, sub)
	return Color3.fromRGB(
		math.max(c.R*255-sub, 0),
		math.max(c.G*255-sub, 0),
		math.max(c.B*255-sub, 0)
	)
end
local function lerpColor(a, b, t)
	return Color3.new(a.R + (b.R-a.R)*t, a.G + (b.G-a.G)*t, a.B + (b.B-a.B)*t)
end

