function ToolxUI:BindKey(keyCode, callback)
	local conn = UIS.InputBegan:Connect(function(i, gp)
		if gp then return end
		if i.KeyCode == keyCode then safe(callback) end
	end)
	table.insert(self.Keybinds, conn)
	return conn
end

-- Language setter
function ToolxUI:SetLanguage(lang)
	self.Config.Language = lang
end

-- Debug logger
function ToolxUI:Log(...)
	if self.Config.Debug then
		print("[ToolxUI]", ...)
	end
end

-- ================== KEY SYSTEM ==================
function ToolxUI:_buildKeySystem()
	local g = Instance.new("ScreenGui")
	g.Name = "ToolxUI_Key"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.DisplayOrder = 1001
	g.Parent = self.Parent
	self.KeyGui = g
	
	local panel = Instance.new("Frame", g)
	panel.Size = UDim2.new(0, 280, 0, 220)
	panel.Position = UDim2.new(0.5, -140, 0.5, -110)
	panel.BackgroundColor3 = Color3.fromRGB(10,10,10)
	panel.BorderSizePixel = 0
	Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 4)
	
	local shine = Instance.new("Frame", panel)
	shine.Size = UDim2.new(1,0,1,0)
	shine.BackgroundColor3 = Color3.fromRGB(255,255,255)
	shine.BackgroundTransparency = 0.85
	shine.BorderSizePixel = 0
	Instance.new("UICorner", shine).CornerRadius = UDim.new(0, 4)
	local sg = Instance.new("UIGradient", shine)
	sg.Transparency = NumberSequence.new{
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.25),
		NumberSequenceKeypoint.new(1, 1)
	}
	sg.Rotation = 30
	addShine(sg, 0.014)
	
	local st = Instance.new("UIStroke", panel)
	st.Thickness = 2
	local stg = Instance.new("UIGradient", st)
	stg.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, self.Config.Accent),
		ColorSequenceKeypoint.new(0.5, brighten(self.Config.Accent, 70)),
		ColorSequenceKeypoint.new(1, self.Config.Accent)
	}
	addSpin(stg, 0.8, "Grad")
	
	local bg = Instance.new("UIGradient", panel)
	bg.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, darken(self.Config.Accent, 200)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8,8,8)),
		ColorSequenceKeypoint.new(1, darken(self.Config.Accent, 200))
	}
	bg.Rotation = 45
	addSpin(bg, 0.8, "Grad")
	
	local title = Instance.new("TextLabel", panel)
	title.Size = UDim2.new(1, -10, 0, 34)
	title.Position = UDim2.new(0, 5, 0, 8)
	title.BackgroundTransparency = 1
	title.Text = "KEY SYSTEM"
	title.TextColor3 = self.Config.Accent
	title.TextSize = 22
	setFont(title, FONTS.Title)
	
	local sub = Instance.new("TextLabel", panel)
	sub.Size = UDim2.new(1, -10, 0, 18)
	sub.Position = UDim2.new(0, 5, 0, 42)
	sub.BackgroundTransparency = 1
	sub.Text = self.Config.Title
	sub.TextColor3 = Color3.fromRGB(255,160,160)
	sub.TextSize = 14
	setFont(sub, FONTS.Body)
	
	local box = Instance.new("TextBox", panel)
	box.Size = UDim2.new(1, -20, 0, 38)
	box.Position = UDim2.new(0, 10, 0, 70)
	box.BackgroundColor3 = Color3.fromRGB(22,8,8)
	box.BorderSizePixel = 0
	box.PlaceholderText = "Enter Key..."
	box.PlaceholderColor3 = Color3.fromRGB(150,80,80)
	box.Text = ""
	box.TextColor3 = Color3.fromRGB(255,220,220)
	box.TextSize = 16
	setFont(box, FONTS.Bold)
	box.ClearTextOnFocus = false
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
	local boxStroke = Instance.new("UIStroke", box)
	boxStroke.Color = Color3.fromRGB(180,40,40)
	boxStroke.Thickness = 1.5
	
	local submit = Instance.new("TextButton", panel)
	submit.Size = UDim2.new(1, -20, 0, 36)
	submit.Position = UDim2.new(0, 10, 0, 116)
	submit.BackgroundColor3 = self.Config.Accent
	submit.BorderSizePixel = 0
	submit.Text = "SUBMIT"
	submit.TextColor3 = Color3.new(1,1,1)
	submit.TextSize = 15
	setFont(submit, FONTS.Title)
	submit.AutoButtonColor = false
	Instance.new("UICorner", submit).CornerRadius = UDim.new(0, 4)
	
	local hint = Instance.new("TextButton", panel)
	hint.Size = UDim2.new(1, -20, 0, 30)
	hint.Position = UDim2.new(0, 10, 0, 158)
	hint.BackgroundColor3 = Color3.fromRGB(40,15,15)
	hint.BorderSizePixel = 0
	hint.Text = "SHOW HINT"
	hint.TextColor3 = Color3.fromRGB(255,200,120)
	hint.TextSize = 13
	setFont(hint, FONTS.Bold)
	hint.AutoButtonColor = false
	Instance.new("UICorner", hint).CornerRadius = UDim.new(0, 4)
	
	local hintLbl = Instance.new("TextLabel", panel)
	hintLbl.Size = UDim2.new(1, -20, 0, 20)
	hintLbl.Position = UDim2.new(0, 10, 0, 192)
	hintLbl.BackgroundTransparency = 1
	hintLbl.Text = ""
	hintLbl.TextColor3 = Color3.fromRGB(255,220,120)
	hintLbl.TextSize = 11
	setFont(hintLbl, FONTS.Reg)
	hintLbl.TextTransparency = 1
	
	hint.MouseButton1Click:Connect(function()
		self:PlayClick(1.4)
		hintLbl.Text = self.Config.KeyHint
		TweenService:Create(hintLbl, TweenInfo.new(0.25), {TextTransparency = 0}):Play()
	end)
	
	self:FireFlames(panel, 3)
	self.KeySystemPanel = panel
	
	local function unlock()
		self:FrameParticles(panel, "out", 40, 90)
		self:PlayClick(0.6)
		task.wait(0.4)
		g:Destroy()
		self.KeyGui = nil
	end
	
	submit.MouseButton1Click:Connect(function()
		self:PlayClick()
		if box.Text == self.Config.Key then
			boxStroke.Color = Color3.fromRGB(60,220,60)
			self:Notify("✓ Access Granted!", self.Theme.Good)
			self:ShakeFrame(panel, 4, 0.2)
			self:FireFlames(panel, 1.5)
			task.wait(0.6)
			unlock()
		else
			boxStroke.Color = Color3.fromRGB(255,40,40)
			self:PlayError()
			self:Notify("✗ Wrong Key!", self.Theme.Danger)
			self:ShakeFrame(panel, 8, 0.3)
			task.wait(0.5)
			boxStroke.Color = Color3.fromRGB(180,40,40)
		end
	end)
end

-- ================== SETTINGS PANEL ==================
function ToolxUI:BuildSettingsPanel()
	-- Simple settings panel open via gear
	local panel = Instance.new("Frame", self.Gui)
	panel.Size = UDim2.new(0, 260, 0, 330)
	panel.Position = UDim2.new(0.5, -130, 1.5, 0)
	panel.BackgroundColor3 = Color3.fromRGB(10,10,10)
	panel.BorderSizePixel = 0
	panel.ClipsDescendants = true
	panel.Visible = false
	Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 4)
	
	local st = Instance.new("UIStroke", panel)
	st.Thickness = 2
	local stg = Instance.new("UIGradient", st)
	stg.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, self.Config.Accent),
		ColorSequenceKeypoint.new(0.5, brighten(self.Config.Accent, 70)),
		ColorSequenceKeypoint.new(1, self.Config.Accent)
	}
	addSpin(stg, 0.8, "Grad")
	
	local bg = Instance.new("UIGradient", panel)
	bg.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, darken(self.Config.Accent, 200)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8,8,8)),
		ColorSequenceKeypoint.new(1, darken(self.Config.Accent, 200))
	}
	bg.Rotation = 45
	addSpin(bg, 0.8, "Grad")
	
	local t = Instance.new("TextLabel", panel)
	t.Size = UDim2.new(1, -40, 0, 26)
	t.Position = UDim2.new(0, 8, 0, 2)
	t.BackgroundTransparency = 1
	t.Text = "Settings"
	t.TextColor3 = self.Theme.Text
	t.TextSize = 16
	setFont(t, FONTS.Title)
	t.TextXAlignment = Enum.TextXAlignment.Left
	
	local back = Instance.new("ImageButton", panel)
	back.Size = UDim2.new(0, 28, 0, 26)
	back.Position = UDim2.new(1, -32, 0, 2)
	back.BackgroundColor3 = Color3.fromRGB(60,15,15)
	back.BorderSizePixel = 0
	back.Image = ICONS.Back
	back.ImageColor3 = self.Config.Accent
	back.AutoButtonColor = false
	Instance.new("UICorner", back).CornerRadius = UDim.new(0, 4)
	
	local open = false
	local settingsOpen = false
	self.GearBtn.MouseButton1Click:Connect(function()
		if settingsOpen then return end
		self:PlayClick()
		local spin = TweenService:Create(self.GearBtn, Ease.QuintInOut, {Rotation = 360})
		spin:Play()
		spin.Completed:Wait()
		self.GearBtn.Rotation = 0
		settingsOpen = true
		self.Main.Visible = false
		panel.Position = self.Main.Position
		panel.Visible = true
		self:FrameParticles(panel, "in", 45, 90)
		self:Shockwave(self.GearBtn, 30, self.Config.Accent, darken(self.Config.Accent, 120), 0.7)
		self:ShakeFrame(panel, 5, 0.25)
	end)
	back.MouseButton1Click:Connect(function()
		if not settingsOpen then return end
		self:PlayClick()
		back.Rotation = 0
		TweenService:Create(back, Ease.QuintInOut, {Rotation = -360}):Play()
		self:FrameParticles(panel, "out", 45, 90)
		self:ShakeFrame(panel, 6, 0.25)
		self:Shockwave(back, 25, self.Config.Accent, darken(self.Config.Accent, 120), 0.65)
		task.wait(0.35)
		panel.Visible = false
		self.Main.Visible = true
		self.GearBtn.Rotation = 360
		TweenService:Create(self.GearBtn, Ease.QuintInOut, {Rotation = 0}):Play()
		self:FrameParticles(self.Main, "in", 25, 60)
		settingsOpen = false
	end)
	
	-- Content: simple effects toggles
	local y = 40
	local keys = {"Sound", "Particles", "Shockwave", "Fire", "Shine", "Spin"}
	for _, k in ipairs(keys) do
		local b = Instance.new("TextButton", panel)
		b.Size = UDim2.new(1, -20, 0, 26)
		b.Position = UDim2.new(0, 10, 0, y)
		b.BackgroundColor3 = self.Config.Effects[k] and self.Config.Accent or Color3.fromRGB(40,12,12)
		b.BorderSizePixel = 0
		b.Text = k..": "..(self.Config.Effects[k] and "ON" or "OFF")
		b.TextColor3 = Color3.new(1,1,1)
		b.TextSize = 12
		setFont(b, FONTS.Bold)
		b.AutoButtonColor = false
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
		b.MouseButton1Click:Connect(function()
			self:PlayClick()
			self.Config.Effects[k] = not self.Config.Effects[k]
			local on = self.Config.Effects[k]
			b.BackgroundColor3 = on and self.Config.Accent or Color3.fromRGB(40,12,12)
			b.Text = k..": "..(on and "ON" or "OFF")
		end)
		y += 30
	end
	self.SettingsPanel = panel
end

-- ================== RETURN ==================
return ToolxUI
