function ToolxUI:BurstAt(x, y, cA, cB, count, dist)
	if not self.Config.Effects.Particles then return end
	count = count or 8
	dist = dist or 25
	cA = cA or self.Config.Accent
	cB = cB or darken(self.Config.Accent, 120)
	for _ = 1, count do
		task.spawn(function()
			local p = Instance.new("Frame")
			p.AnchorPoint = Vector2.new(0.5, 0.5)
			p.Position = UDim2.new(0, x, 0, y)
			p.Size = UDim2.new(0, 6, 0, 6)
			p.BackgroundColor3 = Color3.fromRGB(255,255,255)
			p.BorderSizePixel = 0
			p.ZIndex = 90
			p.Parent = self.FxGui
			Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
			local g = Instance.new("UIGradient", p)
			g.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, cA),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,255,255)),
				ColorSequenceKeypoint.new(1, cB)
			}
			g.Rotation = 45
			addShine(g, 0.09)
			local ang = math.random() * math.pi * 2
			local d = dist * 0.6 + math.random() * dist
			TweenService:Create(p, TweenInfo.new(0.55, Enum.EasingStyle.Quint), {
				Position = UDim2.new(0, x + math.cos(ang)*d, 0, y + math.sin(ang)*d),
				Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1
			}):Play()
			task.wait(0.6)
			p:Destroy()
		end)
	end
end

function ToolxUI:Shockwave(originFrame, size, cA, cB, dur)
	if not self.Config.Effects.Shockwave then return end
	dur = dur or 0.7
	cA = cA or self.Config.Accent
	cB = cB or darken(self.Config.Accent, 120)
	local function makeRing(delay2, scaleMult, thick)
		task.delay(delay2, function()
			local ring = Instance.new("Frame")
			ring.AnchorPoint = Vector2.new(0.5, 0.5)
			ring.Position = UDim2.new(0,
				originFrame.AbsolutePosition.X + originFrame.AbsoluteSize.X/2 - self.FxGui.AbsolutePosition.X, 0,
				originFrame.AbsolutePosition.Y + originFrame.AbsoluteSize.Y/2 - self.FxGui.AbsolutePosition.Y)
			ring.Size = UDim2.new(0, size, 0, size)
			ring.BackgroundColor3 = Color3.fromRGB(255,255,255)
			ring.BackgroundTransparency = 0.15
			ring.BorderSizePixel = 0
			ring.ZIndex = 20
			ring.Parent = self.FxGui
			Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
			local grad = Instance.new("UIGradient", ring)
			grad.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, cA),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,255,255)),
				ColorSequenceKeypoint.new(1, cB)
			}
			grad.Rotation = 45
			addShine(grad, 0.06)
			local stroke = Instance.new("UIStroke", ring)
			stroke.Color = cA
			stroke.Thickness = thick or 3
			local sg2 = Instance.new("UIGradient", stroke)
			sg2.Color = grad.Color
			sg2.Rotation = 45
			addShine(sg2, 0.06)
			TweenService:Create(ring, TweenInfo.new(dur, Enum.EasingStyle.Quint), {
				Size = UDim2.new(0, size*scaleMult, 0, size*scaleMult),
				BackgroundTransparency = 1
			}):Play()
			TweenService:Create(stroke, TweenInfo.new(dur, Enum.EasingStyle.Quint), {
				Transparency = 1, Thickness = 0
			}):Play()
			task.delay(dur + 0.05, function() ring:Destroy() end)
		end)
	end
	makeRing(0, 3, 3)
	makeRing(0.06, 4, 2)
	makeRing(0.12, 5, 1.5)
end

function ToolxUI:ShakeFrame(frame, intensity, dur)
	intensity = intensity or 6
	dur = dur or 0.25
	local bp = frame.Position
	local t0 = tick()
	task.spawn(function()
		while tick() - t0 < dur do
			frame.Position = UDim2.new(bp.X.Scale, bp.X.Offset + (math.random()-0.5)*2*intensity,
				bp.Y.Scale, bp.Y.Offset + (math.random()-0.5)*2*intensity)
			task.wait(0.02)
		end
		frame.Position = bp
	end)
end

function ToolxUI:FireFlames(frame, duration)
	if not self.Config.Effects.Fire then return end
	local t0 = tick()
	task.spawn(function()
		while tick() - t0 < duration do
			if not frame.Parent then break end
			local p = Instance.new("Frame")
			p.AnchorPoint = Vector2.new(0.5, 0.5)
			local px = frame.AbsolutePosition.X - self.FxGui.AbsolutePosition.X + math.random() * frame.AbsoluteSize.X
			local py = frame.AbsolutePosition.Y - self.FxGui.AbsolutePosition.Y + frame.AbsoluteSize.Y - 3
			p.Position = UDim2.new(0, px, 0, py)
			local sz = 6 + math.random() * 10
			p.Size = UDim2.new(0, sz, 0, sz)
			local cols = {Color3.fromRGB(255,80,20), Color3.fromRGB(255,140,30), Color3.fromRGB(255,220,80), Color3.fromRGB(255,255,180)}
			local c = cols[math.random(1, #cols)]
			p.BackgroundColor3 = c
			p.BorderSizePixel = 0
			p.ZIndex = 100
			p.Parent = self.FxGui
			Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
			local g = Instance.new("UIGradient", p)
			g.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 220)),
				ColorSequenceKeypoint.new(0.45, c),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 10, 0))
			}
			g.Rotation = 90
			local rise = 35 + math.random() * 65
			local drift = (math.random() - 0.5) * 30
			TweenService:Create(p, TweenInfo.new(0.6 + math.random()*0.5, Enum.EasingStyle.Quad), {
				Position = UDim2.new(0, px + drift, 0, py - rise),
				Size = UDim2.new(0, sz*0.2, 0, sz*0.2), BackgroundTransparency = 1
			}):Play()
			task.delay(1.3, function() p:Destroy() end)
			task.wait(0.01)
		end
	end)
end

function ToolxUI:FrameParticles(frame, mode, count, dist)
	if not self.Config.Effects.Particles then return end
	count = count or 30
	dist = dist or 70
	local cols = {Color3.fromRGB(255,60,60), Color3.fromRGB(255,110,50), Color3.fromRGB(220,20,20), Color3.fromRGB(255,200,80)}
	for _ = 1, count do
		task.spawn(function()
			local p = Instance.new("Frame")
			p.AnchorPoint = Vector2.new(0.5, 0.5)
			local px = frame.AbsolutePosition.X - self.FxGui.AbsolutePosition.X + math.random() * frame.AbsoluteSize.X
			local py = frame.AbsolutePosition.Y - self.FxGui.AbsolutePosition.Y + math.random() * frame.AbsoluteSize.Y
			local c = cols[math.random(1, #cols)]
			local ang = math.random() * math.pi * 2
			local d = dist * 0.5 + math.random() * dist
			if mode == "out" then p.Position = UDim2.new(0, px, 0, py)
			else p.Position = UDim2.new(0, px + math.cos(ang) * d, 0, py + math.sin(ang) * d) end
			local sz = 4 + math.random() * 7
			p.Size = UDim2.new(0, sz, 0, sz)
			p.BackgroundColor3 = c
			p.BorderSizePixel = 0
			p.ZIndex = 95
			p.Parent = self.FxGui
			Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
			if mode == "out" then
				local ea = math.random() * math.pi * 2
				TweenService:Create(p, TweenInfo.new(0.7, Enum.EasingStyle.Quint), {
					Position = UDim2.new(0, px + math.cos(ea) * d, 0, py + math.sin(ea) * d),
					Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1
				}):Play()
			else
				local tx = frame.AbsolutePosition.X - self.FxGui.AbsolutePosition.X + frame.AbsoluteSize.X/2
				local ty = frame.AbsolutePosition.Y - self.FxGui.AbsolutePosition.Y + frame.AbsoluteSize.Y/2
				TweenService:Create(p, TweenInfo.new(0.7, Enum.EasingStyle.Quint), {
					Position = UDim2.new(0, tx, 0, ty), Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1
				}):Play()
			end
			task.delay(0.85, function() p:Destroy() end)
		end)
		task.wait(0.008)
	end
end

