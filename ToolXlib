function ToolxUI:Notify(text, color, duration)
	color = color or self.Config.Accent
	duration = duration or 3
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(0, 260, 0, 40)
	holder.BackgroundTransparency = 1
	holder.Parent = self.NotifHolder
	
	local shadow = Instance.new("Frame", holder)
	shadow.Size = UDim2.new(1, 8, 1, 8)
	shadow.Position = UDim2.new(0, -4, 0, 3)
	shadow.BackgroundColor3 = Color3.fromRGB(255,255,255)
	shadow.BorderSizePixel = 0
	shadow.BackgroundTransparency = 1
	Instance.new("UICorner", shadow).CornerRadius = UDim.new(0, 2)
	local shGrad = Instance.new("UIGradient", shadow)
	shGrad.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)),
		ColorSequenceKeypoint.new(0.5, color),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0))
	}
	shGrad.Transparency = NumberSequence.new{
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1, 0.25)
	}
	shGrad.Rotation = 90
	
	local f = Instance.new("Frame", holder)
	f.Size = UDim2.new(1, 0, 1, 0)
	f.BackgroundColor3 = Color3.fromRGB(12,12,12)
	f.BorderSizePixel = 0
	f.BackgroundTransparency = 1
	Instance.new("UICorner", f).CornerRadius = UDim.new(0, 2)
	local grad = Instance.new("UIGradient", f)
	grad.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(30,6,6)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8,8,8)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(30,6,6))
	}
	grad.Rotation = 45
	
	local stroke = Instance.new("UIStroke", f)
	stroke.Color = color
	stroke.Thickness = 1.5
	stroke.Transparency = 1
	
	local lbl = Instance.new("TextLabel", f)
	lbl.Size = UDim2.new(1, -10, 1, 0)
	lbl.Position = UDim2.new(0, 5, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = color
	lbl.TextSize = 14
	setFont(lbl, FONTS.Bold)
	lbl.TextTransparency = 1
	lbl.TextXAlignment = Enum.TextXAlignment.Center
	
	task.spawn(function()
		for _ = 1, duration * 30 do
			if not holder.Parent then break end
			shGrad.Rotation = (shGrad.Rotation + 4) % 360
			task.wait(0.033)
		end
	end)
	
	TweenService:Create(f, Ease.QuintOut, {BackgroundTransparency = 0.08}):Play()
	TweenService:Create(shadow, TweenInfo.new(0.25), {BackgroundTransparency = 0.3}):Play()
	TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 0}):Play()
	TweenService:Create(lbl, TweenInfo.new(0.25), {TextTransparency = 0}):Play()
	
	task.delay(duration, function()
		TweenService:Create(f, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
		TweenService:Create(shadow, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
		TweenService:Create(stroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
		TweenService:Create(lbl, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
		task.wait(0.35)
		holder:Destroy()
	end)
end

