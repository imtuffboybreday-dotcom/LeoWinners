-- Attach Tab functions to created tabs
local function attachTab(t)
	for k, v in pairs(Tab) do
		if k ~= "_newHolder" and k ~= "_styledButton" then t[k] = v end
	end
	return t
end

-- Override CreateTab to attach methods
local _oldCreateWindow = ToolxUI.CreateWindow
function ToolxUI:CreateWindow(opt)
	local W = _oldCreateWindow(self, opt)
	local _oldCT = W.CreateTab
	W.CreateTab = function(w, name)
		local tab = _oldCT(w, name)
		attachTab(tab)
		return tab
	end
	return W
end

