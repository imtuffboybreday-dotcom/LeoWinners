local tabButtons = {}
local activeTab = "Draw"
local function createTabButton(name, positionIndex, iconAsset)
	local btn = Instance.new("TextButton", sidebar)
	btn.Name = name .. "Tab"
	btn.Size = UDim2.new(0, 40, 0, 40)
	btn.Position = UDim2.new(0.5, -20, 0, 68 + (positionIndex * 50))
	btn.BackgroundColor3 = COL.BG3
	btn.BackgroundTransparency = (name == activeTab) and 0 or 1
	btn.Text = ""
	btn.AutoButtonColor = false
	corner(btn, 8)
	local iconImg = Instance.new("ImageLabel", btn)
	iconImg.Name = "Icon"
	iconImg.Size = UDim2.new(0, 20, 0, 20)
	iconImg.Position = UDim2.new(0.5, -10, 0.5, -10)
	iconImg.BackgroundTransparency = 1
	iconImg.Image = iconAsset
	iconImg.ImageColor3 = (name == activeTab) and COL.Accent or COL.Text3
	btn.MouseButton1Click:Connect(function()
		if activeTab == name then return end
		pages[activeTab].Visible = false
		local oldBtn = tabButtons[activeTab]
		local oldIcon = oldBtn:FindFirstChild("Icon")
		if oldIcon then
			TweenService:Create(oldIcon, infoFast, {ImageColor3 = COL.Text3}):Play()
		end
		TweenService:Create(oldBtn, infoFast, {BackgroundTransparency = 1}):Play()
		activeTab = name
		pages[activeTab].Visible = true
		TweenService:Create(iconImg, infoFast, {ImageColor3 = COL.Accent}):Play()
		TweenService:Create(btn, infoFast, {BackgroundTransparency = 0}):Play()
	end)
	btn.MouseEnter:Connect(function()
		if activeTab ~= name then
			TweenService:Create(btn, infoFast, {BackgroundTransparency = 0.5}):Play()
			TweenService:Create(iconImg, infoFast, {ImageColor3 = COL.Text2}):Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		if activeTab ~= name then
			TweenService:Create(btn, infoFast, {BackgroundTransparency = 1}):Play()
			TweenService:Create(iconImg, infoFast, {ImageColor3 = COL.Text3}):Play()
		end
	end)
	tabButtons[name] = btn
end
