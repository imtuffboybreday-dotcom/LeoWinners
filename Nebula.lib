--[[
    ╔══════════════════════════════════════════════════════╗
    ║              NEBULA UI  v2.0                         ║
    ║   High-End Roblox UI Library                         ║
    ║                                                      ║
    ║   • Animated gradients + glow images                 ║
    ║   • Advanced minimize (collapse to pill)             ║
    ║   • Draggable + toggle key                           ║
    ║   • Full components + notifications                  ║
    ║   • Config save/load                                 ║
    ╚══════════════════════════════════════════════════════╝
]]

local Nebula = {}
Nebula.__index = Nebula
Nebula.Flags = {}
Nebula.Connections = {}

--// Services
local TS       = game:GetService("TweenService")
local UIS      = game:GetService("UserInputService")
local Players  = game:GetService("Players")
local CoreGui  = game:GetService("CoreGui")
local RunSvc   = game:GetService("RunService")

local LP = Players.LocalPlayer

--// ═══════════════════════════════════════════════════
--// CONFIG + IMAGE IDS
--// ═══════════════════════════════════════════════════
local Config = {
    Title     = "Nebula",
    Subtitle  = "v2.0 • Advanced UI",
    Size      = UDim2.fromOffset(600, 420),
    MinSize   = UDim2.fromOffset(56, 56),
    ToggleKey = Enum.KeyCode.RightShift,

    -- Colors
    Background   = Color3.fromRGB(10, 10, 16),
    Surface      = Color3.fromRGB(20, 20, 30),
    Surface2     = Color3.fromRGB(28, 28, 40),
    Surface3     = Color3.fromRGB(38, 38, 52),
    Text         = Color3.fromRGB(245, 245, 250),
    TextMuted    = Color3.fromRGB(140, 140, 160),
    Accent       = Color3.fromRGB(124, 92, 255),
    Accent2      = Color3.fromRGB(0, 212, 255),
    Accent3      = Color3.fromRGB(255, 92, 200),
    Success      = Color3.fromRGB(0, 226, 150),
    Warning      = Color3.fromRGB(255, 176, 32),
    Danger       = Color3.fromRGB(255, 77, 109),
    Border       = Color3.fromRGB(255, 255, 255),

    -- ⭐ Image IDs (verified, works on most games)
    Images = {
        Glow     = "rbxassetid://5028857472",   -- soft radial glow
        Blur     = "rbxassetid://5028857084",   -- blur/noise texture
        Circle   = "rbxassetid://5554236805",   -- filled circle
        Radial   = "rbxassetid://5920908301",   -- radial gradient
        Gradient = "rbxassetid://6015897843",   -- linear gradient strip
        Check    = "rbxassetid://7072720870",   -- check mark icon
        Chevron  = "rbxassetid://7072717922",   -- down arrow
        Close    = "rbxassetid://7072725342",   -- X icon
        Minus    = "rbxassetid://7072719338",   -- minus icon
        Cog      = "rbxassetid://7072723715",   -- settings icon
    },
}

--// ═══════════════════════════════════════════════════
--// UTILITIES
--// ═══════════════════════════════════════════════════
local function n(inst, props, children)
    local o = Instance.new(inst)
    for k, v in pairs(props or {}) do o[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = o end
    return o
end

local function corner(p, r)
    return n("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = p })
end

local function stroke(p, c, t, tr)
    return n("UIStroke", {
        Color = c or Config.Border,
        Thickness = t or 1,
        Transparency = tr or 0.9,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = p,
    })
end

local function grad(p, c1, c2, rot)
    return n("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rot or 90,
        Parent = p,
    })
end

local function grad3(p, c1, c2, c3, rot)
    return n("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, c1),
            ColorSequenceKeypoint.new(0.5, c2),
            ColorSequenceKeypoint.new(1, c3),
        }),
        Rotation = rot or 90,
        Parent = p,
    })
end

local function pad(p, t, r, b, l)
    return n("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        Parent = p,
    })
end

local function tw(o, t, props, style, dir)
    local i = TweenInfo.new(t or 0.25, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
    local T = TS:Create(o, i, props)
    T:Play()
    return T
end

local function drag(frame, handle)
    handle = handle or frame
    local d, ds, sp = false, nil, nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            d, ds, sp = true, i.Position, frame.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then d = false end
            end)
        end
    end)
    table.insert(Nebula.Connections, UIS.InputChanged:Connect(function(i)
        if d and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
            local delta = i.Position - ds
            frame.Position = UDim2.new(
                sp.X.Scale, sp.X.Offset + delta.X,
                sp.Y.Scale, sp.Y.Offset + delta.Y
            )
        end
    end))
end

--// Animated gradient rotation (high-end effect)
local function animateGradient(gradientObj, speed)
    speed = speed or 40
    table.insert(Nebula.Connections, RunSvc.RenderStepped:Connect(function(dt)
        if gradientObj and gradientObj.Parent then
            gradientObj.Rotation = (gradientObj.Rotation + dt * speed) % 360
        end
    end))
end

--// ═══════════════════════════════════════════════════
--// NOTIFICATIONS
--// ═══════════════════════════════════════════════════
function Nebula:Notify(data)
    data = data or {}
    local title    = data.Title or "Notification"
    local text     = data.Text or ""
    local duration = data.Duration or 4
    local ntype    = data.Type or "info"

    local colorMap = {
        info    = Config.Accent,
        success = Config.Success,
        warning = Config.Warning,
        error   = Config.Danger,
    }
    local c = colorMap[ntype] or Config.Accent
    local gui = self.GUI

    local holder = n("Frame", {
        Name = "Notif",
        Size = UDim2.fromOffset(300, 68),
        Position = UDim2.new(1, 20, 1, -20),
        BackgroundColor3 = Config.Surface,
        BorderSizePixel = 0,
        Parent = gui,
    })
    corner(holder, 14)
    stroke(holder, Config.Border, 1, 0.85)

    -- Left color strip (gradient)
    local strip = n("Frame", {
        Size = UDim2.new(0, 4, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = c,
        BorderSizePixel = 0,
        Parent = holder,
    })
    corner(strip, 2)
    grad(strip, c, Color3.fromRGB(255,255,255), 90)

    -- Icon glow
    local glow = n("ImageLabel", {
        Size = UDim2.fromOffset(48, 48),
        Position = UDim2.new(0, 4, 0, 10),
        BackgroundTransparency = 1,
        Image = Config.Images.Glow,
        ImageColor3 = c,
        ImageTransparency = 0.5,
        Parent = holder,
    })

    n("TextLabel", {
        Text = title,
        Size = UDim2.new(1, -50, 0, 20),
        Position = UDim2.new(0, 20, 0, 12),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = Config.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    n("TextLabel", {
        Text = text,
        Size = UDim2.new(1, -50, 0, 18),
        Position = UDim2.new(0, 20, 0, 34),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Config.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = holder,
    })

    -- Stacking
    local idx = 0
    for _, v in ipairs(gui:GetChildren()) do
        if v:GetAttribute("NebulaNotif") then idx += 1 end
    end
    holder:SetAttribute("NebulaNotif", true)

    local targetY = -20 - (idx * 78)
    holder.Position = UDim2.new(1, 20, 1, targetY)
    tw(holder, 0.45, { Position = UDim2.new(1, -320, 1, targetY) }, Enum.EasingStyle.Back)

    task.delay(duration, function()
        tw(holder, 0.3, {
            Position = UDim2.new(1, 20, 1, targetY),
            BackgroundTransparency = 1,
        })
        tw(glow, 0.3, { ImageTransparency = 1 })
        task.wait(0.32)
        holder:Destroy()
    end)
end

--// ═══════════════════════════════════════════════════
--// WINDOW
--// ═══════════════════════════════════════════════════
function Nebula.new(cfg)
    cfg = cfg or {}
    for k, v in pairs(cfg) do Config[k] = v end

    local self = setmetatable({}, Nebula)
    self.Tabs = {}
    self.ActiveTab = nil
    self.Minimized = false
    self.Collapsed  = false

    -- ScreenGui
    local gui = n("ScreenGui", {
        Name = "NebulaUI_" .. tostring(math.random(1000, 9999)),
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    })
    if gethui then
        gui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(gui); gui.Parent = CoreGui
    else
        pcall(function() gui.Parent = CoreGui end)
        if not gui.Parent then gui.Parent = LP:WaitForChild("PlayerGui") end
    end
    self.GUI = gui

    -- ═══ MAIN WINDOW ═══
    local main = n("Frame", {
        Name = "Main",
        Size = Config.Size,
        Position = UDim2.new(0.5, -Config.Size.X.Offset/2, 0.5, -Config.Size.Y.Offset/2),
        BackgroundColor3 = Config.Background,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        Parent = gui,
    })
    corner(main, 16)
    local mainStroke = stroke(main, Config.Border, 1.2, 0.85)
    self.Main = main
    self.MainStroke = mainStroke

    -- Animated gradient border (high-end effect)
    local borderGrad = n("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Config.Accent),
            ColorSequenceKeypoint.new(0.5, Config.Accent2),
            ColorSequenceKeypoint.new(1, Config.Accent3),
        }),
        Parent = mainStroke,
    })
    animateGradient(borderGrad, 30)

    -- ⭐ Background glow image
    local bgGlow = n("ImageLabel", {
        Name = "BgGlow",
        Size = UDim2.new(1, 120, 1, 120),
        Position = UDim2.new(0, -60, 0, -60),
        BackgroundTransparency = 1,
        Image = Config.Images.Glow,
        ImageColor3 = Config.Accent,
        ImageTransparency = 0.75,
        ZIndex = -2,
        Parent = main,
    })
    corner(bgGlow, 32)
    self.BgGlow = bgGlow

    -- Pulse glow
    task.spawn(function()
        while main.Parent do
            tw(bgGlow, 2.5, { ImageTransparency = 0.55 }, Enum.EasingStyle.Sine)
            task.wait(2.5)
            tw(bgGlow, 2.5, { ImageTransparency = 0.8 }, Enum.EasingStyle.Sine)
            task.wait(2.5)
        end
    end)

    -- Blur texture overlay
    local blurTex = n("ImageLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Image = Config.Images.Blur,
        ImageColor3 = Color3.fromRGB(255,255,255),
        ImageTransparency = 0.96,
        ZIndex = -1,
        Parent = main,
    })
    corner(blurTex, 16)

    -- ═══ MINIMIZED PILL (collapsed state) ═══
    local pill = n("Frame", {
        Name = "Pill",
        Size = UDim2.fromOffset(56, 56),
        Position = UDim2.new(0, 24, 0, 24),
        BackgroundColor3 = Config.Surface,
        BorderSizePixel = 0,
        Visible = false,
        Parent = gui,
    })
    n("UICorner", { CornerRadius = UDim.new(1, 0), Parent = pill })
    stroke(pill, Config.Border, 1, 0.85)

    -- Pill glow
    local pillGlow = n("ImageLabel", {
        Size = UDim2.new(1, 60, 1, 60),
        Position = UDim2.new(0, -30, 0, -30),
        BackgroundTransparency = 1,
        Image = Config.Images.Glow,
        ImageColor3 = Config.Accent,
        ImageTransparency = 0.35,
        Parent = pill,
    })
    corner(pillGlow, 100)

    -- Pill logo
    local pillLogo = n("ImageLabel", {
        Size = UDim2.fromOffset(32, 32),
        Position = UDim2.new(0.5, -16, 0.5, -16),
        BackgroundTransparency = 1,
        Image = Config.Images.Circle,
        ImageColor3 = Color3.fromRGB(255,255,255),
        Parent = pill,
    })

    -- Pill gradient overlay
    local pillGrad = n("UIGradient", {
        Color = ColorSequence.new(Config.Accent, Config.Accent2),
        Rotation = 45,
        Parent = pillLogo,
    })
    animateGradient(pillGrad, 60)
    pillLogo.ImageColor3 = Color3.fromRGB(255,255,255)

    drag(pill)

    -- Click pill to restore
    local pillBtn = n("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = pill,
    })

    self.Pill = pill

    -- ═══ TOPBAR ═══
    local topbar = n("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = Config.Surface,
        BorderSizePixel = 0,
        Parent = main,
    })
    n("UICorner", { CornerRadius = UDim.new(0, 16), Parent = topbar })
    n("Frame", {
        Size = UDim2.new(1, 0, 0, 16),
        Position = UDim2.new(0, 0, 1, -16),
        BackgroundColor3 = Config.Surface,
        BorderSizePixel = 0,
        Parent = topbar,
    })

    -- Top accent gradient bar
    local topAccent = n("Frame", {
        Size = UDim2.new(1, -32, 0, 2),
        Position = UDim2.new(0, 16, 0, 0),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
        Parent = topbar,
    })
    corner(topAccent, 2)
    local topAccGrad = grad3(topAccent, Config.Accent, Config.Accent2, Config.Accent3, 0)
    animateGradient(topAccGrad, 50)

    -- Logo image (gradient circle)
    local logoImg = n("ImageLabel", {
        Size = UDim2.fromOffset(26, 26),
        Position = UDim2.new(0, 20, 0, 15),
        BackgroundTransparency = 1,
        Image = Config.Images.Circle,
        ImageColor3 = Color3.fromRGB(255,255,255),
        Parent = topbar,
    })
    local logoGrad = n("UIGradient", {
        Color = ColorSequence.new(Config.Accent, Config.Accent2),
        Rotation = 45,
        Parent = logoImg,
    })
    animateGradient(logoGrad, 55)

    n("TextLabel", {
        Text = Config.Title,
        Size = UDim2.new(0, 200, 0, 18),
        Position = UDim2.new(0, 54, 0, 12),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextColor3 = Config.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = topbar,
    })
    n("TextLabel", {
        Text = Config.Subtitle,
        Size = UDim2.new(0, 260, 0, 14),
        Position = UDim2.new(0, 54, 0, 30),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = Config.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = topbar,
    })

    -- ⭐ Close button
    local closeBtn = n("TextButton", {
        Text = "",
        Size = UDim2.fromOffset(28, 28),
        Position = UDim2.new(1, -40, 0, 14),
        BackgroundColor3 = Config.Surface2,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Parent = topbar,
    })
    corner(closeBtn, 8)
    n("ImageLabel", {
        Size = UDim2.fromOffset(12, 12),
        Position = UDim2.new(0.5, -6, 0.5, -6),
        BackgroundTransparency = 1,
        Image = Config.Images.Close,
        ImageColor3 = Config.Text,
        Parent = closeBtn,
    })

    -- ⭐ Minimize button (advanced collapse)
    local minBtn = n("TextButton", {
        Text = "",
        Size = UDim2.fromOffset(28, 28),
        Position = UDim2.new(1, -74, 0, 14),
        BackgroundColor3 = Config.Surface2,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Parent = topbar,
    })
    corner(minBtn, 8)
    n("ImageLabel", {
        Size = UDim2.fromOffset(12, 12),
        Position = UDim2.new(0.5, -6, 0.5, -6),
        BackgroundTransparency = 1,
        Image = Config.Images.Minus,
        ImageColor3 = Config.Text,
        Parent = minBtn,
    })

    drag(main, topbar)

    -- ═══ SIDEBAR ═══
    local sidebar = n("Frame", {
        Name = "Sidebar",
        Size = UDim2.new(0, 150, 1, -80),
        Position = UDim2.new(0, 14, 0, 68),
        BackgroundTransparency = 1,
        Parent = main,
    })

    local tabHolder = n("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Config.Accent,
        ScrollBarImageTransparency = 0.5,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = sidebar,
    })
    n("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = tabHolder,
    })

    -- ═══ CONTENT ═══
    local content = n("Frame", {
        Name = "Content",
        Size = UDim2.new(1, -184, 1, -80),
        Position = UDim2.new(0, 172, 0, 68),
        BackgroundTransparency = 1,
        Parent = main,
    })
    self.Content = content
    self.TabHolder = tabHolder
    self.Window = main

    -- ═══ MINIMIZE / RESTORE LOGIC ═══
    local function minimizeToPill()
        self.Collapsed = true
        -- Save position
        local pos = main.AbsolutePosition
        tw(main, 0.3, {
            Size = UDim2.fromOffset(0, 0),
            Position = UDim2.new(0, pos.X + main.AbsoluteSize.X/2, 0, pos.Y + main.AbsoluteSize.Y/2),
            BackgroundTransparency = 1,
        }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.wait(0.28)
        main.Visible = false
        pill.Position = UDim2.fromOffset(pos.X, pos.Y)
        pill.Size = UDim2.fromOffset(0, 0)
        pill.Visible = true
        tw(pill, 0.35, { Size = UDim2.fromOffset(56, 56) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        self:Notify({ Title = "Minimized", Text = "Click icon to restore", Type = "info", Duration = 2 })
    end

    local function restoreFromPill()
        self.Collapsed = false
        local ppos = pill.AbsolutePosition
        tw(pill, 0.25, { Size = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.wait(0.2)
        pill.Visible = false
        pill.Size = UDim2.fromOffset(56, 56)

        main.Visible = true
        main.BackgroundTransparency = 0
        main.Size = UDim2.fromOffset(0, 0)
        main.Position = UDim2.new(0, ppos.X, 0, ppos.Y)
        tw(main, 0.4, {
            Size = Config.Size,
            Position = UDim2.new(0, ppos.X, 0, ppos.Y),
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    minBtn.MouseEnter:Connect(function()
        tw(minBtn, 0.2, { BackgroundColor3 = Config.Warning })
    end)
    minBtn.MouseLeave:Connect(function()
        tw(minBtn, 0.2, { BackgroundColor3 = Config.Surface2 })
    end)
    minBtn.MouseButton1Click:Connect(minimizeToPill)
    pillBtn.MouseButton1Click:Connect(restoreFromPill)

    closeBtn.MouseEnter:Connect(function()
        tw(closeBtn, 0.2, { BackgroundColor3 = Config.Danger })
    end)
    closeBtn.MouseLeave:Connect(function()
        tw(closeBtn, 0.2, { BackgroundColor3 = Config.Surface2 })
    end)
    closeBtn.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    -- Toggle key
    table.insert(Nebula.Connections, UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Config.ToggleKey then
            if self.Collapsed then
                restoreFromPill()
            elseif main.Visible then
                minimizeToPill()
            else
                main.Visible = true
            end
        end
    end))

    return self
end

--// ═══════════════════════════════════════════════════
--// CREATE TAB
--// ═══════════════════════════════════════════════════
function Nebula:CreateTab(name, icon)
    local tabBtn = n("TextButton", {
        Text = "",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Config.Surface,
        BackgroundTransparency = 0.75,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Parent = self.TabHolder,
    })
    corner(tabBtn, 10)

    -- Active indicator bar
    local indicator = n("Frame", {
        Size = UDim2.new(0, 3, 0, 0),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Config.Accent,
        BorderSizePixel = 0,
        Parent = tabBtn,
    })
    corner(indicator, 3)
    grad(indicator, Config.Accent, Config.Accent2, 90)

    local iconLbl = n("TextLabel", {
        Text = icon or "◆",
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(0, 14, 0.5, -10),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = Config.TextMuted,
        Parent = tabBtn,
    })

    local nameLbl = n("TextLabel", {
        Text = name,
        Size = UDim2.new(1, -46, 1, 0),
        Position = UDim2.new(0, 40, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Config.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = tabBtn,
    })

    -- Page
    local page = n("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Config.Accent,
        ScrollBarImageTransparency = 0.4,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.Content,
    })
    n("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = page,
    })
    pad(page, 0, 12, 0, 0)

    local tab = { Button = tabBtn, Page = page, Name = name }

    local function select()
        for _, t in ipairs(self.Tabs) do
            tw(t.Button, 0.25, { BackgroundTransparency = 0.75 })
            tw(t.Indicator, 0.25, { Size = UDim2.new(0, 3, 0, 0) })
            tw(t.Icon,   0.25, { TextColor3 = Config.TextMuted })
            tw(t.Label,  0.25, { TextColor3 = Config.TextMuted })
            t.Page.Visible = false
        end
        tw(tabBtn, 0.25, { BackgroundTransparency = 0.4 })
        tw(indicator, 0.3, { Size = UDim2.new(0, 3, 0, 22) }, Enum.EasingStyle.Back)
        tw(iconLbl, 0.25, { TextColor3 = Config.Text })
        tw(nameLbl, 0.25, { TextColor3 = Config.Text })
        page.Visible = true
        self.ActiveTab = tab
    end

    tabBtn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tw(tabBtn, 0.2, { BackgroundTransparency = 0.6 })
        end
    end)
    tabBtn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tw(tabBtn, 0.2, { BackgroundTransparency = 0.75 })
        end
    end)
    tabBtn.MouseButton1Click:Connect(select)

    tab.Indicator = indicator
    tab.Icon = iconLbl
    tab.Label = nameLbl
    tab.Select = select

    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then select() end

    return tab
end

--// ═══════════════════════════════════════════════════
--// COMPONENT: SECTION
--// ═══════════════════════════════════════════════════
function Nebula:CreateSection(tab, text)
    local holder = n("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
        Parent = tab.Page,
    })
    n("TextLabel", {
        Text = text:upper(),
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = Config.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })
    -- gradient underline
    local line = n("Frame", {
        Size = UDim2.new(0, 40, 0, 1),
        Position = UDim2.new(0, 0, 1, -4),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
        Parent = holder,
    })
    grad(line, Config.Accent, Config.Accent2, 0)
end

--// ═══════════════════════════════════════════════════
--// COMPONENT: BUTTON
--// ═══════════════════════════════════════════════════
function Nebula:CreateButton(tab, opts)
    opts = opts or {}
    local name = opts.Name or "Button"

    local btn = n("TextButton", {
        Text = "",
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Config.Surface2,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Parent = tab.Page,
    })
    corner(btn, 10)
    stroke(btn, Config.Border, 1, 0.9)

    -- gradient overlay
    local gradLayer = n("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
        Parent = btn,
    })
    corner(gradLayer, 10)
    local g = grad3(gradLayer, Config.Accent, Config.Accent2, Config.Accent3, 0)
    animateGradient(g, 25)

    n("TextLabel", {
        Text = name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Config.Text,
        Parent = btn,
    })

    btn.MouseEnter:Connect(function()
        tw(btn, 0.25, { BackgroundColor3 = Config.Surface3 })
        tw(gradLayer, 0.25, { BackgroundTransparency = 0.75 })
    end)
    btn.MouseLeave:Connect(function()
        tw(btn, 0.25, { BackgroundColor3 = Config.Surface2 })
        tw(gradLayer, 0.25, { BackgroundTransparency = 0.9 })
    end)
    btn.MouseButton1Click:Connect(function()
        tw(btn, 0.1, { Size = UDim2.new(0.97, 0, 0, 36) })
        task.wait(0.1)
        tw(btn, 0.2, { Size = UDim2.new(1, 0, 0, 38) }, Enum.EasingStyle.Back)
        if opts.Callback then
            task.spawn(opts.Callback)
        end
    end)

    return btn
end

--// ═══════════════════════════════════════════════════
--// COMPONENT: TOGGLE
--// ═══════════════════════════════════════════════════
function Nebula:CreateToggle(tab, opts)
    opts = opts or {}
    local name = opts.Name or "Toggle"
    local default = opts.Default or false

    local holder = n("TextButton", {
        Text = "",
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Config.Surface2,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Parent = tab.Page,
    })
    corner(holder, 10)
    stroke(holder, Config.Border, 1, 0.9)

    n("TextLabel", {
        Text = name,
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Config.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    -- Toggle pill
    local track = n("Frame", {
        Size = UDim2.fromOffset(44, 22),
        Position = UDim2.new(1, -58, 0.5, -11),
        BackgroundColor3 = Config.Surface3,
        BorderSizePixel = 0,
        Parent = holder,
    })
    n("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

    local trackGrad = grad(track, Config.Accent, Config.Accent2, 0)

    local knob = n("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
        Parent = track,
    })
    n("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local state = default
    local function set(v, fire)
        state = v
        if state then
            tw(track, 0.3, { BackgroundColor3 = Color3.fromRGB(255,255,255) })
            tw(knob, 0.3, { Position = UDim2.new(1, -19, 0.5, -8) }, Enum.EasingStyle.Back)
        else
            tw(track, 0.3, { BackgroundColor3 = Config.Surface3 })
            tw(knob, 0.3, { Position = UDim2.new(0, 3, 0.5, -8) }, Enum.EasingStyle.Back)
        end
        if fire and opts.Callback then opts.Callback(state) end
    end

    set(default, false)
    holder.MouseButton1Click:Connect(function() set(not state, true) end)

    local flag = { Value = state, Set = set }
    Nebula.Flags[name] = flag
    return flag
end

--// ═══════════════════════════════════════════════════
--// COMPONENT: SLIDER
--// ═══════════════════════════════════════════════════
function Nebula:CreateSlider(tab, opts)
    opts = opts or {}
    local name = opts.Name or "Slider"
    local min  = opts.Min or 0
    local max  = opts.Max or 100
    local def  = opts.Default or min
    local suffix = opts.Suffix or ""

    local holder = n("Frame", {
        Size = UDim2.new(1, 0, 0, 52),
        BackgroundColor3 = Config.Surface2,
        BorderSizePixel = 0,
        Parent = tab.Page,
    })
    corner(holder, 10)
    stroke(holder, Config.Border, 1, 0.9)

    n("TextLabel", {
        Text = name,
        Size = UDim2.new(1, -70, 0, 20),
        Position = UDim2.new(0, 14, 0, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Config.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    local valLbl = n("TextLabel", {
        Text = tostring(def) .. suffix,
        Size = UDim2.new(0, 60, 0, 20),
        Position = UDim2.new(1, -74, 0, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Config.Accent2,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = holder,
    })

    local track = n("Frame", {
        Size = UDim2.new(1, -28, 0, 6),
        Position = UDim2.new(0, 14, 0, 36),
        BackgroundColor3 = Config.Surface3,
        BorderSizePixel = 0,
        Parent = holder,
    })
    n("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

    local fill = n("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
        Parent = track,
    })
    n("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
    local fillGrad = grad(fill, Config.Accent, Config.Accent2, 0)
    animateGradient(fillGrad, 20)

    local knob = n("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new(0, -7, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = fill,
    })
    n("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
    stroke(knob, Config.Accent, 2, 0)

    local value = def
    local dragging = false

    local function updateFromX(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel + 0.5)
        tw(fill, 0.1, { Size = UDim2.new(rel, 0, 1, 0) })
        valLbl.Text = tostring(value) .. suffix
        if opts.Callback then opts.Callback(value) end
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(i.Position.X)
        end
    end)
    table.insert(Nebula.Connections, UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(i.Position.X)
        end
    end))
    table.insert(Nebula.Connections, UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    -- init
    local rel0 = (def - min) / (max - min)
    fill.Size = UDim2.new(rel0, 0, 1, 0)
    valLbl.Text = tostring(def) .. suffix

    local flag = { Value = value, Set = function(v)
        value = v
        local rel = (v - min) / (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        valLbl.Text = tostring(v) .. suffix
    end }
    Nebula.Flags[name] = flag
    return flag
end

--// ═══════════════════════════════════════════════════
--// COMPONENT: TEXTBOX
--// ═══════════════════════════════════════════════════
function Nebula:CreateTextbox(tab, opts)
    opts = opts or {}
    local name = opts.Name or "Input"
    local def  = opts.Default or ""
    local ph   = opts.Placeholder or "Type here..."

    local holder = n("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = Config.Surface2,
        BorderSizePixel = 0,
        Parent = tab.Page,
    })
    corner(holder, 10)
    stroke(holder, Config.Border, 1, 0.9)

    n("TextLabel", {
        Text = name,
        Size = UDim2.new(1, -20, 0, 18),
        Position = UDim2.new(0, 14, 0, 6),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = Config.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    local box = n("TextBox", {
        Text = def,
        PlaceholderText = ph,
        Size = UDim2.new(1, -28, 0, 26),
        Position = UDim2.new(0, 14, 0, 24),
        BackgroundColor3 = Config.Surface3,
        BorderSizePixel = 0,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Config.Text,
        PlaceholderColor3 = Config.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        Parent = holder,
    })
    corner(box, 6)
    pad(box, 0, 8, 0, 8)

    box.Focused:Connect(function()
        tw(box, 0.2, { BackgroundColor3 = Config.Surface })
    end)
    box.FocusLost:Connect(function()
        tw(box, 0.2, { BackgroundColor3 = Config.Surface3 })
        if opts.Callback then opts.Callback(box.Text) end
    end)

    Nebula.Flags[name] = { Value = def, Set = function(v) box.Text = v end }
    return box
end

--// ═══════════════════════════════════════════════════
--// COMPONENT: KEYBIND
--// ═══════════════════════════════════════════════════
function Nebula:CreateKeybind(tab, opts)
    opts = opts or {}
    local name = opts.Name or "Keybind"
    local def  = opts.Default or Enum.KeyCode.E
    local current = def
    local listening = false

    local holder = n("TextButton", {
        Text = "",
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Config.Surface2,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Parent = tab.Page,
    })
    corner(holder, 10)
    stroke(holder, Config.Border, 1, 0.9)

    n("TextLabel", {
        Text = name,
        Size = UDim2.new(1, -110, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Config.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    local keyLbl = n("TextButton", {
        Text = def.Name,
        Size = UDim2.fromOffset(84, 24),
        Position = UDim2.new(1, -98, 0.5, -12),
        BackgroundColor3 = Config.Surface3,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = Config.Accent2,
        AutoButtonColor = false,
        Parent = holder,
    })
    corner(keyLbl, 6)

    keyLbl.MouseButton1Click:Connect(function()
        listening = true
        keyLbl.Text = "..."
        tw(keyLbl, 0.2, { BackgroundColor3 = Config.Accent })
    end)

    table.insert(Nebula.Connections, UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if listening then
            listening = false
            current = input.KeyCode
            keyLbl.Text = current.Name
            tw(keyLbl, 0.2, { BackgroundColor3 = Config.Surface3 })
            if opts.Callback then opts.Callback(current) end
        elseif input.KeyCode == current and opts.OnPressed then
            opts.OnPressed()
        end
    end))

    Nebula.Flags[name] = { Value = current, Set = function(k)
        current = k; keyLbl.Text = k.Name
    end }
    return keyLbl
end

--// ═══════════════════════════════════════════════════
--// COMPONENT: DROPDOWN
--// ═══════════════════════════════════════════════════
function Nebula:CreateDropdown(tab, opts)
    opts = opts or {}
    local name = opts.Name or "Dropdown"
    local items = opts.Options or {}
    local multi = opts.Multi or false

    local holder = n("Frame", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Config.Surface2,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = tab.Page,
    })
    corner(holder, 10)
    stroke(holder, Config.Border, 1, 0.9)

    local header = n("TextButton", {
        Text = "",
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Parent = holder,
    })

    n("TextLabel", {
        Text = name,
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Config.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = header,
    })

    local arrow = n("ImageLabel", {
        Size = UDim2.fromOffset(12, 12),
        Position = UDim2.new(1, -30, 0.5, -6),
        BackgroundTransparency = 1,
        Image = Config.Images.Chevron,
        ImageColor3 = Config.TextMuted,
        Parent = header,
    })

    local list = n("Frame", {
        Size = UDim2.new(1, -20, 0, 0),
        Position = UDim2.new(0, 10, 0, 42),
        BackgroundTransparency = 1,
        Parent = holder,
    })
    local ll = n("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = list,
    })

    local expanded = false
    local selected = multi and {} or nil

    local function toggle()
        expanded = not expanded
        tw(arrow, 0.25, { Rotation = expanded and 180 or 0 })
        local targetH = expanded and (38 + #items * 32 + 8) or 38
        tw(holder, 0.3, { Size = UDim2.new(1, 0, 0, targetH) }, Enum.EasingStyle.Quart)
    end

    header.MouseButton1Click:Connect(toggle)

    for i, item in ipairs(items) do
        local opt = n("TextButton", {
            Text = item,
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundColor3 = Config.Surface3,
            BorderSizePixel = 0,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = Config.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            Parent = list,
        })
        corner(opt, 6)
        pad(opt, 0, 10, 0, 10)

        opt.MouseEnter:Connect(function()
            tw(opt, 0.2, { BackgroundColor3 = Config.Surface })
        end)
        opt.MouseLeave:Connect(function()
            tw(opt, 0.2, { BackgroundColor3 = Config.Surface3 })
        end)
        opt.MouseButton1Click:Connect(function()
            if multi then
                selected[item] = not selected[item]
                if selected[item] then
                    opt.BackgroundColor3 = Config.Accent
                else
                    opt.BackgroundColor3 = Config.Surface3
                end
                if opts.Callback then opts.Callback(selected) end
            else
                selected = item
                for _, c in ipairs(list:GetChildren()) do
                    if c:IsA("TextButton") then
                        c.BackgroundColor3 = (c == opt) and Config.Accent or Config.Surface3
                    end
                end
                if opts.Callback then opts.Callback(selected) end
                task.wait(0.15)
                toggle()
            end
        end)
    end

    Nebula.Flags[name] = { Value = selected }
    return { Holder = holder, Get = function() return selected end }
end

--// ═══════════════════════════════════════════════════
--// COMPONENT: LABEL & DIVIDER
--// ═══════════════════════════════════════════════════
function Nebula:CreateLabel(tab, text)
    local lbl = n("TextLabel", {
        Text = text,
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Config.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = tab.Page,
    })
    return lbl
end

function Nebula:CreateDivider(tab)
    local holder = n("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
        Parent = tab.Page,
    })
    grad(holder, Color3.fromRGB(255,255,255), Color3.fromRGB(255,255,255), 0).Transparency =
        NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.5, 0.85),
            NumberSequenceKeypoint.new(1, 1),
        })
end

--// ═══════════════════════════════════════════════════
--// DESTROY
--// ═══════════════════════════════════════════════════
function Nebula:Destroy()
    for _, c in ipairs(Nebula.Connections) do
        pcall(function() c:Disconnect() end)
    end
    Nebula.Connections = {}
    if self.GUI then self.GUI:Destroy() end
end

--// ═══════════════════════════════════════════════════
--// AUTO-LOAD (kalau di loadstring)
--// ═══════════════════════════════════════════════════
return Nebula
