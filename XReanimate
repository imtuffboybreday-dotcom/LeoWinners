local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local StarterGui=game:GetService("StarterGui")
local Workspace=game:GetService("Workspace")
local LocalPlayer=Players.LocalPlayer
local Stepped=RunService.Stepped
local RenderStepped=RunService.RenderStepped
local Character=LocalPlayer.Character
if not Character or not Character.Parent then return end

local noclipAllParts=false
local antiragdoll=true
local newanimate=true
local discharscripts=true
local R15toR6=true
local hatcollide=false
local humState16=true
local addtools=false
local hedafterneck=true
local loadtime=Players.RespawnTime+0.5
local method=3
local alignmode=3
local c=Character

c.Destroying:Connect(function()
	c=nil
end)

local ZERO=Vector3.zero

local function gp(parent,name,className)
	if typeof(parent)~="Instance" then return end
	for _,v in ipairs(parent:GetChildren()) do
		if v.Name==name and v:IsA(className) then
			return v
		end
	end
end

local function align(Part0,Part1)
	if not Part0 or not Part1 then return end
	if not Part0:IsA("BasePart") or not Part1:IsA("BasePart") then return end

	pcall(function()
		Part0.CustomPhysicalProperties=PhysicalProperties.new(0.01,0,0,0,0)
		Part0.CanCollide=false
		Part0.CanTouch=false
		Part0.CanQuery=false
		Part0.Massless=true
		Part0.AssemblyLinearVelocity=ZERO
		Part0.AssemblyAngularVelocity=ZERO
	end)

	pcall(function()
		Part1.CanCollide=false
		Part1.CanTouch=false
		Part1.CanQuery=false
	end)

	local att0=Instance.new("Attachment")
	att0.Name="XStable_Att0_"..Part0.Name
	att0.Position=ZERO
	att0.Orientation=ZERO
	att0.Parent=Part0

	local att1=Instance.new("Attachment")
	att1.Name="XStable_Att1_"..Part1.Name
	att1.Position=ZERO
	att1.Orientation=ZERO
	att1.Parent=Part1

	local ap=Instance.new("AlignPosition")
	ap.Name="XStableAlignPosition"
	ap.Attachment0=att0
	ap.Attachment1=att1
	ap.ApplyAtCenterOfMass=true
	ap.MaxForce=1000000
	ap.MaxVelocity=math.huge
	ap.Responsiveness=200
	ap.ReactionForceEnabled=false
	ap.RigidityEnabled=false
	ap.Parent=Part0

	local ao=Instance.new("AlignOrientation")
	ao.Name="XStableAlignOrientation"
	ao.Attachment0=att0
	ao.Attachment1=att1
	ao.MaxTorque=1000000
	ao.MaxAngularVelocity=math.huge
	ao.Responsiveness=200
	ao.ReactionTorqueEnabled=false
	ao.RigidityEnabled=false
	ao.Parent=Part0
end

local function respawnrequest()
	if not c then return end
	local camera=Workspace.CurrentCamera
	if not camera then return end
	local oldCFrame=camera.CFrame
	local oldCharacter=LocalPlayer.Character
	LocalPlayer.Character=nil
	LocalPlayer.Character=oldCharacter
	local connection
	connection=camera.Changed:Connect(function(property)
		if property~="Parent" and property~="CFrame" then return end
		pcall(function()
			camera.CFrame=oldCFrame
		end)
		if connection then
			connection:Disconnect()
			connection=nil
		end
	end)
end

local destroyhum=method==4 or method==5
local breakjoints=method==0 or method==4
local antirespawn=method==0 or method==2 or method==3
hatcollide=hatcollide and method==0

if antiragdoll then
	local function removeRagdollConstraint(v)
		if not v or not v.Parent then return end
		if v:IsA("HingeConstraint") or v:IsA("BallSocketConstraint") then
			pcall(function()
				v:Destroy()
			end)
		end
	end
	for _,v in ipairs(c:GetDescendants()) do
		removeRagdollConstraint(v)
	end
	c.DescendantAdded:Connect(removeRagdollConstraint)
end

if antirespawn then
	respawnrequest()
end

if method==0 then
	task.wait(loadtime)
	if not c then return end
end

if discharscripts then
	for _,v in ipairs(c:GetChildren()) do
		if v:IsA("LocalScript") then
			pcall(function()
				v.Disabled=true
			end)
		end
	end
elseif newanimate then
	local animate=gp(c,"Animate","LocalScript")
	if animate and not animate.Disabled then
		animate.Disabled=true
	else
		newanimate=false
	end
end

local Backpack
if addtools then
	Backpack=LocalPlayer:FindFirstChildOfClass("Backpack")
end

if addtools and Backpack then
	for _,v in ipairs(Backpack:GetChildren()) do
		if v:IsA("Tool") then
			v.Parent=c
		end
	end
end

pcall(function()
	settings().Physics.AllowSleep=false
	settings().Physics.PhysicsEnvironmentalThrottle=Enum.EnviromentalPhysicsThrottle.Disabled
end)

local OLDscripts={}
for _,v in ipairs(c:GetDescendants()) do
	if v.ClassName=="Script" then
		table.insert(OLDscripts,v)
	end
end

local scriptNames={}

for i,v in ipairs(c:GetDescendants()) do
	if v:IsA("BasePart") then
		local newName=tostring(i)
		local exists=true
		while exists do
			exists=false
			for _,oldScript in ipairs(OLDscripts) do
				if oldScript.Name==newName then
					exists=true
					newName=newName.."_"
					break
				end
			end
		end
		table.insert(scriptNames,newName)
		local marker=Instance.new("Script")
		marker.Name=newName
		marker.Parent=v
	end
end

c.Archivable=true

local hum=c:FindFirstChildOfClass("Humanoid")

if hum then
	for _,track in ipairs(hum:GetPlayingAnimationTracks()) do
		pcall(function()
			track:Stop()
		end)
	end
end

local cl=c:Clone()
if not cl then return end
cl.Name=LocalPlayer.Name

if hum and humState16 then
	pcall(function()
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	end)
	if destroyhum then
		task.wait(1.6)
	end
end

if hum and hum.Parent and destroyhum then
	pcall(function()
		hum:Destroy()
	end)
end

if not c then return end

local head=gp(c,"Head","BasePart")
local torso=gp(c,"Torso","BasePart") or gp(c,"UpperTorso","BasePart")
local root=gp(c,"HumanoidRootPart","BasePart")

if hatcollide and c:FindFirstChildOfClass("Accessory") then
	local anything=c:FindFirstChildOfClass("BodyColors") or gp(c,"Health","Script")
	if not torso or not root or not anything then return end
	pcall(function()
		torso:Destroy()
		root:Destroy()
	end)
	anything:Destroy()
end

for _,v in ipairs(cl:GetDescendants()) do
	if v:IsA("BasePart") then
		v.Transparency=1
		v.Anchored=false
		pcall(function()
			v.CanCollide=false
			v.CanTouch=false
			v.CanQuery=false
			v.Massless=true
		end)
	end
end

local model=Instance.new("Model")
model.Name="ReanimateModel"
model.Parent=c

model.Destroying:Connect(function()
	model=nil
end)

for _,v in ipairs(c:GetChildren()) do
	if v~=model then
		if addtools and v:IsA("Tool") then
			for _,v1 in ipairs(v:GetDescendants()) do
				if v1:IsA("BasePart") then
					local bv=Instance.new("BodyVelocity")
					bv.Velocity=ZERO
					bv.MaxForce=Vector3.new(1000,1000,1000)
					bv.P=1250
					bv.Name="StableToolVelocity"
					bv.Parent=v1
				end
			end
		end
		v.Parent=model
	end
end

if breakjoints then
	model:BreakJoints()
else
	if head and torso then
		for _,v in ipairs(model:GetDescendants()) do
			if v:IsA("Weld") or v:IsA("Snap") or v:IsA("Glue") or v:IsA("Motor") or v:IsA("Motor6D") then
				local save=false
				if v.Part0==torso and v.Part1==head then save=true end
				if v.Part0==head and v.Part1==torso then save=true end
				if save then
					if hedafterneck then
						hedafterneck=v
					end
				else
					pcall(function()
						v:Destroy()
					end)
				end
			end
		end
	end

	if method==3 then
		task.spawn(function()
			task.wait(loadtime)
			if model then
				pcall(function()
					model:BreakJoints()
				end)
			end
		end)
	end
end

cl.Parent=c

for _,v in ipairs(cl:GetChildren()) do
	v.Parent=c
end

cl:Destroy()

local noclipmodel=(noclipAllParts and c) or model
local noclipcon

local function uncollide()
	if not noclipmodel then return end
	for _,v in ipairs(noclipmodel:GetDescendants()) do
		if v:IsA("BasePart") then
			pcall(function()
				v.CanCollide=false
				v.CanTouch=false
				v.CanQuery=false
				v.Massless=true
			end)
		end
	end
end

noclipcon=Stepped:Connect(uncollide)
uncollide()

for _,scr in ipairs(model:GetDescendants()) do
	if scr.ClassName=="Script" and table.find(scriptNames,scr.Name) then
		local Part0=scr.Parent
		if Part0 and Part0:IsA("BasePart") then
			for _,scr1 in ipairs(c:GetDescendants()) do
				if scr1.ClassName=="Script" and scr1.Name==scr.Name and not scr1:IsDescendantOf(model) then
					local Part1=scr1.Parent
					if Part1 and Part1:IsA("BasePart") and Part1.Name==Part0.Name then
						align(Part0,Part1)
						break
					end
				end
			end
		end
	end
end

for _,v in ipairs(c:GetDescendants()) do
	if v and v.Parent then
		if v.ClassName=="Script" then
			if table.find(scriptNames,v.Name) then
				pcall(function()
					v:Destroy()
				end)
			end
		elseif not v:IsDescendantOf(model) then
			if v:IsA("Decal") then
				v.Transparency=1
			elseif v:IsA("ForceField") then
				v.Visible=false
			elseif v:IsA("Sound") then
				v.Playing=false
			elseif v:IsA("BillboardGui") or v:IsA("SurfaceGui") or v:IsA("ParticleEmitter") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
				v.Enabled=false
			end
		end
	end
end

if newanimate then
	local animate=gp(c,"Animate","LocalScript")
	if animate then
		pcall(function()
			animate.Disabled=false
		end)
	end
end

if addtools and Backpack then
	for _,v in ipairs(c:GetChildren()) do
		if v:IsA("Tool") then
			v.Parent=Backpack
		end
	end
end

local hum0=model:FindFirstChildOfClass("Humanoid")

if hum0 then
	hum0.Destroying:Connect(function()
		hum0=nil
	end)
end

local hum1=c:FindFirstChildOfClass("Humanoid")

if hum1 then
	hum1.Destroying:Connect(function()
		hum1=nil
	end)
end

if hum1 then
	pcall(function()
		Workspace.CurrentCamera.CameraSubject=hum1
	end)

	local camSubCon

	local function camSubFunc()
		if camSubCon then
			camSubCon:Disconnect()
			camSubCon=nil
		end
		if c and hum1 then
			pcall(function()
				Workspace.CurrentCamera.CameraSubject=hum1
			end)
		end
	end

	camSubCon=RenderStepped:Connect(camSubFunc)

	if hum0 then
		hum0:GetPropertyChangedSignal("Jump"):Connect(function()
			if hum1 then
				pcall(function()
					hum1.Jump=hum0.Jump
				end)
			end
		end)
	else
		respawnrequest()
	end
end

local rb=Instance.new("BindableEvent")
rb.Name="ReanimateReset"
rb.Parent=c

rb.Event:Connect(function()
	pcall(function()
		rb:Destroy()
	end)

	pcall(function()
		StarterGui:SetCore("ResetButtonCallback",true)
	end)

	if destroyhum then
		pcall(function()
			c:BreakJoints()
		end)
		return
	end

	if hum0 and hum0.Health>0 then
		pcall(function()
			model:BreakJoints()
		end)
		pcall(function()
			hum0.Health=0
		end)
	end

	if antirespawn then
		respawnrequest()
	end
end)

pcall(function()
	StarterGui:SetCore("ResetButtonCallback",rb)
end)

task.spawn(function()
	while c do
		if hum0 and hum1 then
			pcall(function()
				hum1.Jump=hum0.Jump
			end)
		end
		task.wait()
	end

	pcall(function()
		StarterGui:SetCore("ResetButtonCallback",true)
	end)
end)

pcall(function()
	StarterGui:SetCore("SendNotification",{
		Title="XReanimate V2",
		Text="Credits to: Theo for the Logic",
		Duration=5
	})
end)
