local function makeToggle(textKey, pos, size, stateRef, onChange)
	local b = Instance.new("TextButton", Main)
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = BTN_DEFAULT.loopOff
	b.BorderSizePixel = 0
	b.TextColor3 = Color3.new(1,1,1)
	b.TextSize = 12
	setFont(b, FONT_BOLD)
	b.AutoButtonColor = false
	b.ZIndex = 5
	b:SetAttribute("BaseColor", BTN_DEFAULT.loopOff)
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
	local g = Instance.new("UIGradient", b)
	makeShineOverlay(b, 6)
	local function refresh()
		local on = stateRef()
		b.Text = T(textKey)..": "..T(on and "on" or "off")
		local c = on and BTN_DEFAULT.loopOn or BTN_DEFAULT.loopOff
		b.BackgroundColor3 = c
		b:SetAttribute("BaseColor", c)
		g.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, c), ColorSequenceKeypoint.new(0.5, brighten(c, 40)), ColorSequenceKeypoint.new(1, c)}
		g.Rotation = 30
	end
	b.MouseButton1Click:Connect(function() playClick() onChange(not stateRef()) refresh() end)
	b.MouseEnter:Connect(function()
		playHover()
		local base = b:GetAttribute("BaseColor") or BTN_DEFAULT.loopOff
		TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = brighten(base, 35)}):Play()
	end)
	b.MouseLeave:Connect(function()
		local base = b:GetAttribute("BaseColor") or BTN_DEFAULT.loopOff
		TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = base}):Play()
	end)
	refresh()
	b:SetAttribute("DoRefresh", true)
	return b
end
