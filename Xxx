		settings.language, tostring(settings.effects.sound), tostring(settings.effects.particles),
		tostring(settings.effects.shockwave), tostring(settings.effects.fire))
end
local function parseConfig(text)
	local data = {}
	for line in text:gmatch("[^\n]+") do
		local k, v = line:match("^([^=]+)=(.+)$")
		if k and v then data[k] = v end
	end
	return data
end
local function saveConfigFile(name)
	if not name or name == "" then return false end
	return pcall(function() writefile(CONFIG_FOLDER.."/"..name..".txt", serializeSettings()) end)
end
local function deleteConfigFile(name)
	return pcall(function()
		local p = CONFIG_FOLDER.."/"..name..".txt"
		if isfile(p) then delfile(p) end
	end)
end
local function listConfigFiles()
	local out = {}
	pcall(function()
		for _, f in ipairs(listfiles(CONFIG_FOLDER)) do
			local name = f:match("([^/\\]+)%.txt$")
			if name then table.insert(out, name) end
		end
	end)
	return out
end
