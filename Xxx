applyAccent = function()
	pcall(function()
		local a = settings.accent
		local lighter = Color3.fromRGB(math.min(a.R*255+70,255), math.min(a.G*255+70,255), math.min(a.B*255+70,255))
		local newCol = ColorSequence.new{
			ColorSequenceKeypoint.new(0, a),
			ColorSequenceKeypoint.new(0.5, lighter),
			ColorSequenceKeypoint.new(1, a)
		}
		if sg then sg.Color = newCol end
		if kSG then kSG.Color = newCol end
		if title then title.TextColor3 = a end
		if kTitle then kTitle.TextColor3 = a end
		if tog then
			tog.TextColor3 = a
			tog.BackgroundColor3 = Color3.fromRGB(math.floor(a.R*10+6), math.floor(a.G*10+6), math.floor(a.B*10+6))
		end
		if minBtn then minBtn.ImageColor3 = a end
		if settingsBtn then settingsBtn.ImageColor3 = a end
		if backBtn then backBtn.ImageColor3 = a end
		if tsg then
			tsg.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, a),
