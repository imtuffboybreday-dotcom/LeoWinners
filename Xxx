local function giveTool(target)
	if not target or not target.Character then return end
	if isOwner(target) then notify("⚠ Owner Cant Gived", Color3.fromRGB(255,215,0)) return end
	refreshChar() lockCamera()
	local tc = target.Character
	local tRoot = tc:FindFirstChild("HumanoidRootPart")
	if not tRoot or not tc:FindFirstChildOfClass("Humanoid") then unlockCamera() return end
	local tool = getTool()
	if not tool then unlockCamera() return end
	if hrp then hrp.CFrame = tRoot.CFrame * CFrame.new(0,0,2.5) savedCF = hrp.CFrame end
	task.wait(0.08)
	if hum and tool.Parent ~= char then pcall(function() hum:EquipTool(tool) end) task.wait(0.06) end
	local ra = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
	local tt = tc:FindFirstChild("Torso") or tc:FindFirstChild("UpperTorso") or tRoot
	if ra and tt then
		for _, m in ipairs(ra:GetChildren()) do
			if m:IsA("Motor6D") or m:IsA("Weld") or m:IsA("WeldConstraint") then m:Destroy() end
		end
		ra.CFrame = tt.CFrame
		ra.AssemblyLinearVelocity = Vector3.zero
		ra.AssemblyAngularVelocity = Vector3.zero
		ra.CanCollide = false
		task.wait(0.03)
		local w = Instance.new("WeldConstraint")
		w.Name = "RightArmToTarget"
		w.Part0 = ra
		w.Part1 = tt
		w.Parent = ra
	end
	task.wait(0.03)
	local a = char:FindFirstChild("Animate")
	if a then a.Disabled = true end
	local h = char:FindFirstChildOfClass("Humanoid")
	if h then h:Destroy() end
	unlockCamera()
end
local function toolKill(target)
	if not target or not target.Character then return end
	if isOwner(target) then notify("⚠ Owner Cant Killed", Color3.fromRGB(255,215,0)) return end
	refreshChar()
	local tn = target.DisplayName or target.Name
	local ocf = hrp and hrp.CFrame or nil
	local ok, handle = attachTool(target)
	if not ok then return end
	lockCamera()
	bodyGoToVoid()
	task.wait(0.03)
	local killed = false
	local t0 = tick()
	while tick() - t0 < 6 do
		local tc = target.Character
		local th = tc and tc:FindFirstChildOfClass("Humanoid")
		local tRoot = tc and tc:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = VOID_CF
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
		if tc and tRoot then
			for _ = 1, 15 do fireAll(handle, tc) end
			local y = tRoot.Position.Y
			if y < VOID_THRESHOLD then
				pcall(function()
					tRoot.CFrame = CFrame.new(tRoot.Position.X, VOID_Y * 0.99, tRoot.Position.Z)
				end)
			end
			if y < KILL_THRESHOLD then
				pcall(function()
					tRoot.AssemblyLinearVelocity = Vector3.new(0, FALL_VELOCITY_BOOST, 0)
					tRoot.AssemblyAngularVelocity = Vector3.zero
				end)
			end
		end
		if not tc or not th or th.Health <= 0 then
			killed = true
			break
		end
		RunService.Heartbeat:Wait()
	end
	bodyReturnFromVoid(ocf)
	waitUntilBackAt(ocf, 2)
	unlockCamera()
	if killed then
		notify("☠ "..tn.." "..T("killed"), Color3.fromRGB(255,60,60))
	else
		notify("⚠ "..tn.." "..T("failed"), Color3.fromRGB(255,180,60))
	end
end
