local function serializeSettings()
	return string.format("w=%d\nh=%d\naccentR=%d\naccentG=%d\naccentB=%d\nlang=%s\nsound=%s\nparticles=%s\nshockwave=%s\nfire=%s",
		settings.width, settings.height,
