	if toolSeen[tool.Name] then return end
	toolSeen[tool.Name] = true
	local ok, clone = pcall(function() return tool:Clone() end)
	if ok and clone then clone.Parent = toolBank end
end
local function scanContainer(c)
	if not c then return end
	for _, v in ipairs(c:GetChildren()) do
