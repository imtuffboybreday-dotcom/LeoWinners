local function updateList(f)
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
	end
	f = string.lower(f or "")
	local y = 0
	local players = Players:GetPlayers()
	table.sort(players, function(a, b)
		if isOwner(a) and not isOwner(b) then return true end
		if isOwner(b) and not isOwner(a) then return false end
		return false
	end)
	for _, p in ipairs(players) do
		if p ~= lp then
			local n, d = string.lower(p.Name), string.lower(p.DisplayName)
			if f == "" or string.find(n, f) or string.find(d, f) then
				if isOwner(p) then
					local lbl = Instance.new("TextLabel", list)
					lbl.Size = UDim2.new(1,-4,0,16)
					lbl.BackgroundTransparency = 1
					lbl.Text = "👑 Owner Of Tool.x 👑"
					lbl.TextColor3 = Color3.fromRGB(255, 215, 0)
					lbl.TextSize = 11
					setFont(lbl, FONT_TITLE)
					lbl.TextXAlignment = Enum.TextXAlignment.Center
					lbl.ZIndex = 5
					local og = Instance.new("UIGradient", lbl)
					og.Color = ColorSequence.new{
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
						ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 240, 120)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 60))
					}
					og.Rotation = 45
					addShine(og, 0.035)
					local ost = Instance.new("UIStroke", lbl)
					ost.Color = Color3.fromRGB(255, 200, 40)
					ost.Thickness = 1
					ost.Transparency = 0.4
					y += 18
				end
				local b = Instance.new("TextButton", list)
				b.Size = UDim2.new(1,-4,0,26)
				b.BackgroundColor3 = isOwner(p) and Color3.fromRGB(50,30,10) or Color3.fromRGB(28,10,10)
				b.BorderSizePixel = 0
				b.Text = (isOwner(p) and "👑 " or "") .. p.DisplayName
				b.TextColor3 = isOwner(p) and Color3.fromRGB(255,220,120) or Color3.fromRGB(240,200,200)
				b.TextSize = 13
				setFont(b, FONT_BODY)
				b.AutoButtonColor = false
				b.ZIndex = 5
				b:SetAttribute("PlayerId", p.UserId)
				Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
				if isOwner(p) then
					local bst = Instance.new("UIStroke", b)
					bst.Color = Color3.fromRGB(255, 200, 40)
					bst.Thickness = 1.2
					bst.Transparency = 0.3
				end
				b.MouseButton1Click:Connect(function()
					playClick()
					selected = p
					for _, x in ipairs(list:GetChildren()) do
						if x:IsA("TextButton") then
							local pid = x:GetAttribute("PlayerId")
							if pid == OWNER_ID then
								x.BackgroundColor3 = Color3.fromRGB(50,30,10)
							else
								x.BackgroundColor3 = Color3.fromRGB(28,10,10)
							end
						end
					end
					b.BackgroundColor3 = isOwner(p) and Color3.fromRGB(90,60,20) or Color3.fromRGB(130,22,22)
				end)
				y += 29
			end
		end
	end
	list.CanvasSize = UDim2.new(0,0,0,y)
end
