		settings.effects.particles = data.particles == "true"
		settings.effects.shockwave = data.shockwave == "true"
		settings.effects.fire = data.fire == "true"
	end)
	if ok then
		if applySettings then applySettings() end
		notify("✓ "..T("loaded").." "..name, Color3.fromRGB(80,255,120))
