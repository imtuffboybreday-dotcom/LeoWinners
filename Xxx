				local on = (tb == lk) and loopKill or loopAll
				local key = (tb == lk) and "loopKill" or "loopAll"
				tb.Text = T(key)..": "..T(on and "on" or "off")
			end
		end
		if custScroll then
			for _, c in ipairs(custScroll:GetChildren()) do
				if c:IsA("TextButton") and c:GetAttribute("FxKey") then
